@{ var id = ViewData["Id"] as string ?? ""; var title = ViewData["Title"] as string ?? ""; var description = ViewData["Description"] as string ?? ""; }
<dialog id="@id" class="ui-dialog" aria-labelledby="@(id)-title" aria-describedby="@(id)-description">
  <header class="ui-dialog-header"><h2 id="@(id)-title">@title</h2><p id="@(id)-description">@description</p></header>
  <div class="ui-dialog-body"><p>Use the shared modal shell for consistent dialog presentation.</p>
    <form method="dialog"><button type="submit" class="ui-button ui-button--secondary">Close</button></form>
  </div>
</dialog>
