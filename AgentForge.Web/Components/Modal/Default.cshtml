@model AgentForge.Web.Components.Modal.ModalViewModel
@using AgentForge.Web.Components.Button
@{
    var confirm = Model.Variant == "confirm";
    var titleId = $"{Model.Id}-title";
    var descriptionId = $"{Model.Id}-description";
}
<dialog id="@Model.Id" class="ui-dialog ui-dialog--@(confirm ? "confirm" : "standard")" aria-labelledby="@titleId" aria-describedby="@descriptionId">
    <div class="ui-dialog-layout">
        <header class="ui-dialog-header">
            <div>
                <h2 id="@titleId">@Model.Title</h2>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p id="@descriptionId">@Model.Description</p>
                }
            </div>
            <form method="dialog">@await Component.InvokeAsync("Button", new { model = new ButtonViewModel { Text = "×", Type = "submit", Variant = "ghost", CssClass = "ui-dialog-close", AriaLabel = "Close dialog" } })</form>
        </header>
        @if (!string.IsNullOrWhiteSpace(Model.BodyText))
        {
            <div class="ui-dialog-body"><p>@Model.BodyText</p></div>
        }
        <footer class="ui-dialog-footer">
            <form method="dialog">@await Component.InvokeAsync("Button", new { model = new ButtonViewModel { Text = Model.CancelText, Type = "submit", Variant = "secondary" } })</form>
            @await Component.InvokeAsync("Button", new { model = new ButtonViewModel { Text = Model.PrimaryText, Id = Model.PrimaryButtonId, Variant = confirm ? "danger" : "primary" } })
        </footer>
    </div>
</dialog>
