@model AgentForge.Web.Components.Modal.ModalViewModel
@{
    var confirm = Model.Variant == "confirm";
    var titleId = Model.TitleId ?? $"{Model.Id}-title";
    var descriptionId = Model.DescriptionId ?? $"{Model.Id}-description";
}
<dialog id="@Model.Id" class="ui-dialog ui-dialog--@(confirm ? "confirm" : "standard") @Model.CssClass" aria-labelledby="@titleId" aria-describedby="@(string.IsNullOrWhiteSpace(Model.Description) ? null : descriptionId)">
    @if (Model.CustomLayout) { @Model.Content }
    else {
    <div class="ui-dialog-layout">
        <header class="ui-dialog-header">
            <div>
                <h2 id="@titleId">@Model.Title</h2>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p id="@descriptionId">@Model.Description</p>
                }
            </div>
            <form method="dialog"><ui-button id="@Model.CloseButtonId" type="submit" variant="ghost" css-class="ui-dialog-close" aria-label="Close dialog">×</ui-button></form>
        </header>
        <div class="ui-dialog-body">
            @if (Model.CustomContent) { @Model.Content }
            else if (!string.IsNullOrWhiteSpace(Model.BodyText)) { <p>@Model.BodyText</p> }
        </div>
        <footer class="ui-dialog-footer @(Model.Variant == "wizard" ? "agent-dialog-footer" : "")">
            <form method="dialog"><ui-button id="@Model.CancelButtonId" type="submit" variant="secondary" text="@Model.CancelText" /></form>
            @if (Model.Variant == "wizard")
            {
                <div class="agent-dialog-footer-right">
                    <ui-button id="@Model.PreviousButtonId" variant="secondary" text="Back" hidden="true" />
                    <ui-button id="@Model.NextButtonId" variant="primary" text="Next →" />
                    <ui-button id="@Model.SubmitButtonId" variant="primary" text="Review Complete" hidden="true" />
                </div>
            }
            else
            {
                <ui-button text="@Model.PrimaryText" id="@Model.PrimaryButtonId" variant="@(confirm ? "danger" : "primary")" />
            }
        </footer>
    </div>
    }
</dialog>
