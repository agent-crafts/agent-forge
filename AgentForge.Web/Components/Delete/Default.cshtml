@model AgentForge.Web.Components.Delete.DeleteViewModel
@using AgentForge.Web.Components.Modal
@{
    var body = string.IsNullOrWhiteSpace(Model.ItemName)
        ? Model.Description
        : $"Confirm deletion of {Model.ItemName}. {Model.Description}";
}
@await Component.InvokeAsync("Modal", new
{
    model = new ModalViewModel
    {
        Id = Model.Id,
        Title = Model.Title,
        Description = "",
        BodyText = body,
        Variant = "confirm",
        CssClass = "ui-delete-dialog",
        PrimaryText = Model.ConfirmText,
        PrimaryButtonId = Model.ConfirmButtonId,
        CancelText = Model.CancelText
    }
})
