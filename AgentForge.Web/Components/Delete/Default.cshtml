@model AgentForge.Web.Components.Delete.DeleteViewModel
<dialog id="@Model.Id" class="ui-dialog ui-dialog--confirm ui-delete-dialog" aria-labelledby="@(Model.Id)-title" aria-describedby="@(Model.Id)-description">
    <div class="ui-dialog-layout">
        <header class="ui-dialog-header">
            <div>
                <h2 id="@(Model.Id)-title">@Model.Title</h2>
                <p id="@(Model.Id)-description">@Model.Description</p>
            </div>
            <form method="dialog"><button type="submit" class="ui-dialog-close" aria-label="Close dialog">×</button></form>
        </header>
        @if (!string.IsNullOrWhiteSpace(Model.ItemName))
        {
            <div class="ui-dialog-body"><p>You're about to delete <strong>@Model.ItemName</strong>.</p></div>
        }
        <footer class="ui-dialog-footer">
            <form method="dialog"><button type="submit" class="ui-button ui-button--secondary">@Model.CancelText</button></form>
            <button type="button" id="@Model.ConfirmButtonId" class="ui-button ui-button--danger">@Model.ConfirmText</button>
        </footer>
    </div>
</dialog>
