@{ var id = ViewData["Id"] as string ?? ""; var label = ViewData["Label"] as string ?? ""; var hint = ViewData["Hint"] as string ?? ""; var required = ViewData["Required"] is true; var control = ViewData["Control"] as string ?? "input"; }
<div class="ui-field">
  <label class="ui-field-label" for="@id">@label @if (required) { <span aria-hidden="true">*</span> }</label>
  @if (control == "textarea") {
    <ui-textarea id="@id" name="@(ViewData["Name"] as string ?? id)" placeholder="@(ViewData["Placeholder"] as string ?? "")" required="@required" rows="@(ViewData["Rows"] as int? ?? 4)" max-length="@(ViewData["MaxLength"] as int?)" />
  } else if (control == "select") {
    <ui-select id="@id" name="@(ViewData["Name"] as string ?? id)" required="@required" options="@(ViewData["Options"] as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)" />
  } else {
    <ui-input id="@id" name="@(ViewData["Name"] as string ?? id)" placeholder="@(ViewData["Placeholder"] as string ?? "")" required="@required" max-length="@(ViewData["MaxLength"] as int?)" />
  }
  @if (!string.IsNullOrEmpty(hint)) { <small class="ui-field-hint">@hint</small> }
  <span class="ui-field-error" id="@(id)-error" role="alert" hidden></span>
</div>
