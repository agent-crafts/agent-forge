@model IReadOnlyList<AgentForge.Core.Domains.Project>
@{
    Layout = "_AppLayout";
    var pageNumber = (int)(ViewData["PageNumber"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
}
<div class="ui-toolbar mb-6 flex flex-wrap items-center gap-3">
    <label class="ui-visually-hidden" for="projectSearch">Search projects</label>
    <div class="min-w-0 flex-1"><input class="ui-input w-full" id="projectSearch" type="search" placeholder="Search projects..." /></div>
    <button type="button" id="openProjectDialog" class="ui-button inline-flex h-11 items-center rounded-xl border border-line-strong bg-raised px-4 text-sm font-semibold">+ Add Project</button>
</div>
<div class="ui-grid grid grid-cols-1 gap-3 lg:grid-cols-2" id="projectsGrid">
@foreach (var project in Model)
{
    <a class="ui-item-card group flex min-w-0 gap-3 rounded-xl border border-line bg-surface px-3 py-3 text-content no-underline hover:border-line-strong hover:bg-hover" href="/projects/@project.Id" data-project-search="@($"{project.Name} {project.Description}".ToLowerInvariant())">
        <span class="ui-icon-tile self-start" aria-hidden="true">
            @if (project.Icon.StartsWith("projects/", StringComparison.Ordinal))
            {
                <img src="@("/api/files/" + project.Icon)" alt="" width="40" height="40" class="h-10 w-10 rounded-lg object-cover" />
            }
            else
            {
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="40" height="40"><path d="M3 7a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v10H3z"/></svg>
            }
        </span>
        <span class="ui-item-content flex min-w-0 flex-1 flex-col gap-1">
            <span class="ui-item-title text-sm font-semibold text-heading">@project.Name</span>
            <span class="ui-item-description truncate text-xs text-muted">@(project.Description ?? "No description")</span>
        </span>
    </a>
}
</div>
@if (Model.Count == 0) { <p class="mt-4 text-sm text-muted">No projects yet. Create your first project.</p> }
<p id="projectSearchEmpty" class="mt-4 text-sm text-muted" hidden>No projects match your search.</p>
<div class="mt-6 flex gap-3">
@if (pageNumber > 1) { <a class="ui-button rounded-xl border border-line px-4 py-2" href="/projects?pageNumber=@(pageNumber - 1)">Previous</a> }
@if (pageNumber < totalPages) { <a class="ui-button rounded-xl border border-line px-4 py-2" href="/projects?pageNumber=@(pageNumber + 1)">Next</a> }
</div>
<dialog id="projectDialog" class="w-full max-w-xl rounded-xl border border-line bg-surface p-6 text-content shadow-xl">
    <form id="createProjectForm" class="flex flex-col gap-4">
        <h2 class="text-lg font-semibold">Add Project</h2>
        <label for="projectName">Project Name</label>
        <input id="projectName" class="ui-input" name="name" maxlength="200" required />
        <label for="projectIconUpload" class="ui-field-label">Project icon (optional)</label>
        <div class="ui-file">
            <label class="ui-file-avatar" for="projectIconUpload">
                <span id="projectIconFallback" class="ui-file-fallback" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v10H3z"/></svg></span>
                <img id="projectIconPreview" class="ui-file-preview" alt="" width="96" height="96" hidden />
                <span class="ui-file-change" aria-hidden="true">✎</span>
                <input id="projectIconUpload" class="ui-file-input" type="file" accept="image/png,image/jpeg,image/webp,image/gif" />
            </label>
            <p class="ui-file-hint">PNG, JPG, WebP or GIF, up to 2 MB.</p>
        </div>
        <label for="projectDescription">Description</label>
        <textarea id="projectDescription" class="ui-input" name="description" maxlength="2000" rows="4"></textarea>
        <p id="projectFormError" class="text-sm text-red-600" role="alert" hidden></p>
        <div class="flex justify-end gap-3">
            <button type="button" id="cancelProjectDialog" class="ui-button rounded-xl border border-line px-4 py-2">Cancel</button>
            <button type="submit" class="ui-button rounded-xl border border-line-strong bg-raised px-4 py-2 font-semibold">Create Project</button>
        </div>
    </form>
</dialog>
@Html.AntiForgeryToken()
<script src="~/js/projects/projects.js" asp-append-version="true"></script>
