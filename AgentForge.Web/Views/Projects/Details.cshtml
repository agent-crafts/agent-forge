@model AgentForge.Web.Controllers.ProjectsController.ProjectCard
@{
    Layout = "_AppLayout";
}
<div class="ui-detail" id="projectProfile" data-project-id="@Model.Id">
    <section class="ui-profile ui-tool-profile">
        <div class="ui-tool-actions" role="group" aria-label="Project actions">
            <button type="button" class="ui-button ui-tool-action ui-tool-action--edit" id="editProjectButton" aria-label="Edit project" title="Edit project"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L9 17l-4 1 1-4Z"/></svg></button>
            <button type="button" class="ui-button ui-tool-action ui-tool-action--delete" id="deleteProjectButton" aria-label="Delete project" title="Delete project"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M5 6l1 14h12l1-14M10 10v7M14 10v7"/></svg></button>
        </div>
        <div class="ui-profile-icon" aria-hidden="true">
            @if (Model.Icon.StartsWith("/api/files/", StringComparison.Ordinal))
            {
                <img src="@Model.Icon" alt="" width="64" height="64" class="h-16 w-16 rounded-xl object-cover" />
            }
            else
            {
                <partial name="~/Views/Projects/_ProjectIcon.cshtml" />
            }
        </div>
        <div class="ui-profile-main">
            <div class="ui-profile-title"><h1>@Model.Name</h1></div>
        </div>
    </section>
    <section class="ui-panel mt-6">
        <h2>Overview</h2>
        <p class="ui-subtitle">Project description and information.</p>
        <p>@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</p>
    </section>
</div>
<partial name="~/Views/Projects/_CreateProjectDialog.cshtml" />
<ui-delete id="deleteProjectDialog" title="Delete project?" description="The project will be removed from the active list" item-name="@Model.Name" confirm-button-id="confirmDeleteProject" confirm-text="Delete project" />
@Html.AntiForgeryToken()
<script src="~/js/projects/project-create.js" asp-append-version="true"></script>
<script src="~/js/projects/project-profile-actions.js" asp-append-version="true"></script>
