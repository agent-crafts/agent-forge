@{
    var section = (string)(ViewData["Section"] ?? "");
    var isChat = section == "chat";
}
<aside class="sidebar" id="workspaceSidebar">
    <a class="brand" href="/chat"><span class="brand-mark">✦</span><span>AgentForge <small>AGENT WORKSPACE</small></span></a>
    <div class="chat-sidebar-group">
        <button type="button" class="chat-group-toggle" id="chatGroupToggle" aria-expanded="@(isChat ? "true" : "false")" aria-controls="chatTabs"><svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/></svg> Chat <span class="chat-chevron">⌄</span></button>
        <div class="chat-tabs" id="chatTabs" hidden="@(!isChat)">
            <button class="chat-tab-new" id="newChat" type="button"><span>＋</span> New Chat</button>
            <div id="chatTabList" class="chat-tab-list" aria-label="Conversations">@if (!isChat) { <a class="chat-tab" href="/chat">Open conversations →</a> }</div>
        </div>
    </div>
    <nav class="app-nav" aria-label="Workspace navigation">
        <div class="side-label">DEVELOPMENT OPERATIONS</div>
        @foreach (var item in new[] { ("projects", "M3 7h18M5 7V5a2 2 0 0 1 2-2h3l2 2h5a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z", "Projects"), ("specifications", "M8 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9l-6-6H8Zm7 0v6h6M8 13h8M8 17h8", "Specifications"), ("workflows", "M6 3v12m0 0a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm0-12a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm12 6a3 3 0 1 0 0 6 3 3 0 0 0 0-6ZM9 6h4a5 5 0 0 1 5 5", "Workflows"), ("tasks", "M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11", "Tasks"), ("reviews", "M20 6 9 17l-5-5M4 4h16v16H4z", "Reviews & Approvals"), ("pipelines", "M4 7h6m4 0h6M4 17h6m4 0h6M10 4l4 3-4 3M10 14l4 3-4 3", "Pipelines") })
        {
            var active = item.Item1 == section;
            <a class="side-link @(active ? "active" : "")" aria-current="@(active ? "page" : null)" href="/@(item.Item1)"><svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="@item.Item2" /></svg><span class="sidebar-link-label">@item.Item3</span></a>
        }
        <div class="side-label nav-section-break">AGENT STUDIO</div>
        @foreach (var item in new[] { ("agents", "M12 3v3M5 9H3m18 0h-2M5 19h14a2 2 0 0 0 2-2v-6a5 5 0 0 0-5-5H8a5 5 0 0 0-5 5v6a2 2 0 0 0 2 2Zm3-7h.01M16 12h.01M9 16h6", "Agents"), ("tools", "M14.7 6.3a5 5 0 0 0-6.4 6.4L3 18l3 3 5.3-5.3a5 5 0 0 0 6.4-6.4L14 13l-3-3 3.7-3.7Z", "Tools"), ("knowledge", "M12 7v14M3 18V5a2 2 0 0 1 2-2h4a3 3 0 0 1 3 3 3 3 0 0 1 3-3h4a2 2 0 0 1 2 2v13h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3H3Z", "Knowledge"), ("runs", "M12 6v6l4 2M22 12a10 10 0 1 1-3-7", "Runs") })
        {
            var active = item.Item1 == section;
            <a class="side-link @(active ? "active" : "")" aria-current="@(active ? "page" : null)" href="/@(item.Item1)"><svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="@item.Item2" /></svg><span class="sidebar-link-label">@item.Item3</span></a>
        }
    </nav>
    <div class="side-footer"><span class="status-dot"></span> Local workspace</div>
</aside>
