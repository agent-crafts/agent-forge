@{
    var section = (string)(ViewData["Section"] ?? "");
    var isChat = section == "chat";
    var icons = new Dictionary<string, string> {
        ["dashboard"]="M3 10.5 12 3l9 7.5V21h-6v-7H9v7H3V10.5Z",
        ["projects"]="M3 7h18M5 7V5l3-2h4l2 2h5v14H5Z",
        ["specifications"]="M6 3h9l4 4v14H6ZM15 3v5h4M9 12h7M9 16h7",
        ["workflows"]="M4 7h7l3 5h6M4 17h7l3-5h6",
        ["tasks"]="M4 12l5 5L20 6M4 4h16v16H4",
        ["reviews"]="M4 12l5 5L20 6",
        ["pipelines"]="M4 7h16M4 12h16M4 17h16",
        ["agents"]="M12 3v3M4 12H2m20 0h-2M6 20h12a3 3 0 0 0 3-3v-6a5 5 0 0 0-5-5H8a5 5 0 0 0-5 5v6a3 3 0 0 0 3 3ZM8 13h.01M16 13h.01",
        ["tools"]="M14 6a5 5 0 0 0-6 6l-5 6 3 3 6-5a5 5 0 0 0 6-6l-4 3-3-3Z",
        ["runs"]="M12 6v6l4 2M21 12a9 9 0 1 1-3-7",
        ["discovery"]="M11 3a8 8 0 1 0 0 16 8 8 0 0 0 0-16ZM17 17l4 4",
        ["design"]="M3 21l6-2 12-12-4-4L5 15l-2 6ZM14 6l4 4",
        ["development"]="M8 8l-4 4 4 4M16 8l4 4-4 4M14 4l-4 16",
        ["quality"]="M12 2l8 4v6c0 5-3 8-8 10-5-2-8-5-8-10V6l8-4ZM8 12l3 3 5-6",
        ["deployment"]="M12 3l5 5-5 5-5-5 5-5ZM12 13v8M5 18h14",
        ["chat"]="M21 11a8 8 0 0 1-8 8 9 9 0 0 1-4-1l-6 3 2-6a8 8 0 1 1 16-4Z"
    };
}
<aside class="sidebar" id="workspaceSidebar">
    <a class="brand" href="/projects"><span class="brand-mark">✦</span><span>AgentForge <small data-workspace-brand>ADMINISTRATION</small></span></a>
    <nav class="app-nav workspace-admin-nav" aria-label="Administration navigation">
        <div class="side-label">PROJECT MANAGEMENT</div>
        @foreach (var item in new[] { ("projects", "Projects"), ("tasks", "Tasks") })
        {
            <a class="side-link @(section == item.Item1 ? "active" : "")" aria-current="@(section == item.Item1 ? "page" : null)" href="/@(item.Item1)"><svg class="sidebar-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="@icons[item.Item1]" /></svg><span class="sidebar-nav-label">@item.Item2</span></a>
        }
        <div class="side-label nav-section-break">AGENT STUDIO</div>
        @foreach (var item in new[] { ("agents", "Agents"), ("tools", "Tools"), ("runs", "Runs") })
        {
            <a class="side-link @(section == item.Item1 ? "active" : "")" aria-current="@(section == item.Item1 ? "page" : null)" href="/@(item.Item1)"><svg class="sidebar-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="@icons[item.Item1]" /></svg><span class="sidebar-nav-label">@item.Item2</span></a>
        }
    </nav>
    <nav class="app-nav workspace-user-nav" aria-label="Project workspace navigation" hidden>
        <label class="workspace-project-label" for="workspaceProjectSelect">MY PROJECTS</label>
        <div class="workspace-project-picker">
        <button type="button" id="workspaceProjectToggle" class="workspace-project-toggle" aria-haspopup="listbox" aria-expanded="false" aria-controls="workspaceProjectOptions" disabled><span id="workspaceProjectName">Loading projects…</span><span aria-hidden="true">⌄</span></button>
        <div id="workspaceProjectOptions" class="workspace-project-options ui-dropdown-panel" role="listbox" aria-label="Projects" hidden></div>
        <select id="workspaceProjectSelect" class="workspace-project-select" aria-label="Active project" tabindex="-1" hidden>
            <option value="">Loading projects…</option>
        </select>
        </div>
        <p class="workspace-project-feedback" id="workspaceProjectFeedback" role="status" hidden></p>
        <div class="side-label nav-section-break">PROJECT WORKSPACE</div>
        <a class="side-link @(section == "projects" ? "active" : "")" href="#" id="workspaceProjectOverview"><svg class="sidebar-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="@icons["dashboard"]" /></svg><span class="sidebar-nav-label">Dashboard</span></a>
        <a class="side-link @(section == "project-board" ? "active" : "")" href="#" data-project-section="board"><svg class="sidebar-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="@icons["tasks"]" /></svg><span class="sidebar-nav-label">Board</span></a>
        <a class="side-link @(section == "project-specifications" ? "active" : "")" href="#" data-project-section="specifications"><svg class="sidebar-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="@icons["specifications"]" /></svg><span class="sidebar-nav-label">Specifications</span></a>
        <a class="side-link @(section == "project-assistant" || isChat ? "active" : "")" href="#" data-project-section="assistant"><svg class="sidebar-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="@icons["chat"]" /></svg><span class="sidebar-nav-label">Assistant</span></a>
        <div class="side-label nav-section-break">DEVELOPMENT OPERATIONS</div>
        @foreach (var item in new[] { ("discovery", "Discovery"), ("design", "Design"), ("development", "Development"), ("quality", "Quality"), ("deployment", "Deployment") })
        {
            <a class="side-link @(section == "project-" + item.Item1 ? "active" : "")" href="#" data-project-section="@item.Item1"><svg class="sidebar-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="@icons[item.Item1]" /></svg><span class="sidebar-nav-label">@item.Item2</span></a>
        }
        <div class="side-label nav-section-break">AGENT STUDIO</div>
        @foreach (var item in new[] { ("workflows", "Workflows"), ("runs", "Runs") })
        {
            <a class="side-link @(section == "project-" + item.Item1 ? "active" : "")" href="#" data-project-section="@item.Item1"><svg class="sidebar-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="@icons[item.Item1]" /></svg><span class="sidebar-nav-label">@item.Item2</span></a>
        }
    </nav>
    @* Retained as hidden DOM hooks for the existing chat script; no conversation controls in the sidebar. *@
    <div class="chat-sidebar-group" data-chat-sidebar hidden aria-hidden="true">
        <button type="button" class="chat-group-toggle" id="chatGroupToggle" aria-expanded="false" aria-controls="chatTabs">Conversations <span class="chat-chevron">⌄</span></button>
        <div class="chat-tabs" id="chatTabs" hidden>
            <button class="chat-tab-new" id="newChat" type="button"><span>＋</span> New Chat</button>
            <div id="chatTabList" class="chat-tab-list" aria-label="Conversations"></div>
        </div>
    </div>
    <div class="side-footer">
        <div class="workspace-admin-only"><a class="side-link @(section == "design-system" ? "active" : "")" href="/design-system">Design System</a></div>
        <div><span class="status-dot"></span> Local workspace</div>
    </div>
</aside>