@{
    var section = (string)(ViewData["Section"] ?? "");
    var isChat = section == "chat";
    var iconPaths = new Dictionary<string, string> {
        ["projects"]="M3 7h18M5 7V5l3-2h4l2 2h5v14H5Z",
        ["specifications"]="M6 3h9l4 4v14H6ZM15 3v5h4M9 12h7M9 16h7",
        ["workflows"]="M4 7h7l3 5h6M4 17h7l3-5h6",
        ["tasks"]="M4 12l5 5L20 6M4 4h16v16H4",
        ["reviews"]="M4 12l5 5L20 6",
        ["pipelines"]="M4 7h16M4 12h16M4 17h16",
        ["agents"]="M12 3v3M4 12H2m20 0h-2M6 20h12a3 3 0 0 0 3-3v-6a5 5 0 0 0-5-5H8a5 5 0 0 0-5 5v6a3 3 0 0 0 3 3ZM8 13h.01M16 13h.01",
        ["tools"]="M14 6a5 5 0 0 0-6 6l-5 6 3 3 6-5a5 5 0 0 0 6-6l-4 3-3-3Z",
        ["runs"]="M12 6v6l4 2M21 12a9 9 0 1 1-3-7"
    };
}
<aside class="sidebar" id="workspaceSidebar">
    <a class="brand" href="/chat"><span class="brand-mark">✦</span><span>AgentForge <small>AGENT WORKSPACE</small></span></a>
    <div class="chat-sidebar-group">
        <button type="button" class="chat-group-toggle" id="chatGroupToggle" aria-expanded="@(isChat ? "true" : "false")" aria-controls="chatTabs"><svg class="sidebar-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 11a8 8 0 0 1-8 8 9 9 0 0 1-4-1l-6 3 2-6a8 8 0 1 1 16-4Z"/></svg> Chat <span class="chat-chevron">⌄</span></button>
        <div class="chat-tabs" id="chatTabs" hidden="@(!isChat)">
            <button class="chat-tab-new" id="newChat" type="button"><span>＋</span> New Chat</button>
            <div id="chatTabList" class="chat-tab-list" aria-label="Conversations">@if (!isChat) { <a class="chat-tab" href="/chat">Open conversations →</a> }</div>
        </div>
    </div>
    <nav class="app-nav" aria-label="Workspace navigation">
        <div class="side-label">DEVELOPMENT OPERATIONS</div>
        @foreach (var item in new[] { ("projects", "▣", "Projects"), ("specifications", "▤", "Specifications"), ("workflows", "⑂", "Workflows"), ("tasks", "☑", "Tasks"), ("reviews", "✓", "Reviews & Approvals"), ("pipelines", "⇢", "Pipelines") })
        {
            var active = item.Item1 == section;
            <a class="side-link @(active ? "active" : "")" aria-current="@(active ? "page" : null)" href="/@(item.Item1)"><svg class="sidebar-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="@iconPaths[item.Item1]" /></svg><span class="sidebar-nav-label">@item.Item3</span></a>
        }
        <div class="side-label nav-section-break">AGENT STUDIO</div>
        @foreach (var item in new[] { ("agents", "✧", "Agents"), ("tools", "⚒", "Tools"), ("runs", "◷", "Runs") })
        {
            var active = item.Item1 == section;
            <a class="side-link @(active ? "active" : "")" aria-current="@(active ? "page" : null)" href="/@(item.Item1)"><svg class="sidebar-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="@iconPaths[item.Item1]" /></svg><span class="sidebar-nav-label">@item.Item3</span></a>
        }
    </nav>
    <div class="side-footer"><span class="status-dot"></span> Local workspace</div>
</aside>
