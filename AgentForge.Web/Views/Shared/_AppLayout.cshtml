@{
    Layout = "_Layout";
}
<div class="shell">
    <partial name="_Sidebar" />
    <main class="main">
        <partial name="_Topbar" />
        <section class="@(ViewData["Section"] as string == "chat" ? "chat-content" : "page-content")">
            @RenderBody()
        </section>
    </main>
</div>
<script src="~/js/app-shell.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
