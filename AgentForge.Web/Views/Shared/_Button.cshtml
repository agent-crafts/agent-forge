@model UiButtonModel
@{
    var buttonClass = $"ui-button ui-button--{Model.Variant.ToString().ToLowerInvariant()} {Model.CssClass}".Trim();
}
@if (Model.CloseDialog)
{
    <button type="@Model.Type" id="@Model.Id" class="@buttonClass" disabled="@Model.Disabled" data-modal-close>@Model.Text</button>
}
else
{
    <button type="@Model.Type" id="@Model.Id" class="@buttonClass" disabled="@Model.Disabled">@Model.Text</button>
}
