@model UiButtonModel
@{
    var buttonClass = $"ui-button ui-button--{Model.Variant.ToString().ToLowerInvariant()} {Model.CssClass}".Trim();
}
<button type="@Model.Type" id="@Model.Id" class="@buttonClass" disabled="@Model.Disabled"
        role="@Model.Role" aria-controls="@Model.AriaControls" aria-selected="@Model.AriaSelected"
        tabindex="@Model.TabIndex" data-copy-target="@Model.CopyTarget"
        data-modal-close="@(Model.CloseDialog ? "" : null)">
    @if (!string.IsNullOrEmpty(Model.Icon))
    {
        <span aria-hidden="true">@Model.Icon</span>
    }
    @if (Model.IconName is "pencil" or "trash-2")
    {
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            @if (Model.IconName == "pencil")
            {
                <path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L9 17l-4 1 1-4Z"/>
            }
            else
            {
                <path d="M3 6h18M8 6V4h8v2M5 6l1 14h12l1-14M10 10v7M14 10v7"/>
            }
        </svg>
    }
    @if (Model.IconName is not null && !string.IsNullOrWhiteSpace(Model.Text))
    {
        <span>@Model.Text</span>
    }
    else if (Model.LabelId is { } labelId)
    {
        <span id="@labelId">@Model.Text</span>
    }
    else
    {
        @Model.Text
    }
</button>
