<dialog id="addToolDialog" class="ui-modal" aria-labelledby="addToolTitle" aria-describedby="addToolIntro">
    <div class="ui-modal-shell">
        <header class="ui-modal-header">
            <div><h2 id="addToolTitle">Add Tool</h2><p id="addToolIntro">Configure a custom tool or connect an external source.</p></div>
            <button type="button" class="ui-modal-close" data-tool-close aria-label="Close dialog">×</button>
        </header>
        <div class="ui-modal-body">
            <fieldset class="ui-modal-options">
                <legend class="ui-field-label">Tool type</legend>
                <label class="ui-modal-choice"><input type="radio" name="toolKind" value="custom" checked /><span><strong>Custom Tool</strong><small>Define a tool built for AgentForge.</small></span></label>
                <label class="ui-modal-choice"><input type="radio" name="toolKind" value="external" /><span><strong>External Tool</strong><small>Discover tools from a trusted external provider.</small></span></label>
            </fieldset>
            <section data-tool-panel="custom" class="ui-modal-panel" aria-label="Custom tool configuration">
                <h3>Basic information</h3>
                <label class="ui-field-label" for="newToolName">Tool name</label>
                <input class="ui-input" id="newToolName" name="name" placeholder="read_project_status" pattern="[a-z][a-z0-9_]*" maxlength="100" />
                <label class="ui-field-label" for="newToolDisplayName">Display name</label>
                <input class="ui-input" id="newToolDisplayName" name="displayName" placeholder="Read Project Status" maxlength="120" />
                <label class="ui-field-label" for="newToolDescription">Description</label>
                <textarea class="ui-input ui-modal-textarea" id="newToolDescription" name="description" placeholder="What does this tool do?"></textarea>
                <h3>Parameters</h3>
                <p class="ui-modal-help">Define input parameters. The JSON Schema preview is generated automatically.</p>
                <div id="toolParameterRows" class="ui-modal-parameters"></div>
                <button type="button" id="addToolParameter" class="ui-button">+ Add parameter</button>
                <label class="ui-field-label" for="newToolSchema">Generated JSON Schema</label>
                <pre class="ui-modal-code"><code id="newToolSchema"></code></pre>
                <p class="ui-modal-help">An approved implementation and execution policy are required before this tool can run.</p>
            </section>
            <section data-tool-panel="external" class="ui-modal-panel" aria-label="External tool configuration" hidden>
                <h3>Choose source</h3>
                <label class="ui-field-label" for="externalToolSource">Source type</label>
                <select class="ui-select" id="externalToolSource"><option value="openapi">OpenAPI / Swagger</option><option value="mcp">MCP Server</option><option value="integration">Existing integration</option></select>
                <div id="externalEndpointField">
                    <label class="ui-field-label" for="externalToolEndpoint">Specification URL / server endpoint</label>
                    <input class="ui-input" id="externalToolEndpoint" type="url" placeholder="https://example.com/openapi.json" />
                </div>
                <div id="externalIntegrationField" hidden>
                    <label class="ui-field-label" for="externalToolIntegration">Integration</label>
                    <select class="ui-select" id="externalToolIntegration"><option value="">Choose an integration</option><option value="github">GitHub</option><option value="jira">Jira</option></select>
                </div>
                <p class="ui-modal-help">Discovery requires a trusted connection, validation, and explicit review of imported tools. No external endpoint is contacted by this form.</p>
            </section>
            <p id="addToolFeedback" class="ui-modal-feedback" role="status" aria-live="polite"></p>
        </div>
        <footer class="ui-modal-footer">
            <button type="button" class="ui-button" data-tool-close>Cancel</button>
            <button type="button" class="ui-button ui-modal-primary" id="previewToolConfiguration">Preview configuration</button>
        </footer>
    </div>
</dialog>