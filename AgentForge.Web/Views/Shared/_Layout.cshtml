<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0d1117">
    <title>@ViewData["Title"] — AgentForge</title>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/agent-chat.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/confirm-dialog.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/toast.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/ui-components.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true">
</head>
<body>
    @RenderBody()
    <partial name="_ConfirmDialog" />
    <partial name="_Toast" />
    <script src="~/js/shared/confirm-dialog.js" asp-append-version="true"></script>
    <script src="~/js/shared/toast.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
