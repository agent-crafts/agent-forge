@{
    Layout = "_AppLayout";
    var section = (string)(ViewData["Section"] ?? "");
}
<section class="workspace-content">
    <partial name="_PageHeading" />
    @if (section == "agents")
    {
        <partial name="_AgentsContent" />
    }
    else
    {
        <partial name="_PlaceholderContent" />
    }
</section>
