@{
    Layout = "_AppLayout";
    var projectName = ViewData["ProjectName"] as string ?? "Project";
    var title = ViewData["Title"] as string ?? "Workspace";
    var stageKey = title.ToLowerInvariant();
    var stages = new[] { ("discovery", "Discovery", "Product Owner"), ("design", "Design", "Design Agent"), ("development", "Development", "Engineering Agent"), ("quality", "Quality", "QA Agent"), ("deployment", "Deployment", "DevOps Agent") };
    var projectId = ViewData["ProjectId"] as string ?? "";
    var stageIndex = Array.FindIndex(stages, stage => stage.Item1 == stageKey);
    var agent = stageIndex >= 0 ? stages[stageIndex].Item3 : "Project Assistant";
    // Keep Development Operations header icons aligned with the sidebar navigation.
    var stageIconPaths = new Dictionary<string, string> {
        ["discovery"] = "M11 3a8 8 0 1 0 0 16 8 8 0 0 0 0-16ZM17 17l4 4",
        ["design"] = "M3 21l6-2 12-12-4-4L5 15l-2 6ZM14 6l4 4",
        ["development"] = "M8 8l-4 4 4 4M16 8l4 4-4 4M14 4l-4 16",
        ["quality"] = "M12 2l8 4v6c0 5-3 8-8 10-5-2-8-5-8-10V6l8-4ZM8 12l3 3 5-6",
        ["deployment"] = "M12 3l5 5-5 5-5-5 5-5ZM12 13v8M5 18h14"
    };
    // Illustrative estimates only; telemetry and forecasting are not wired yet.
    var demoProgress = new[] { 100, 60, 30, 0, 0 };
    var demoTokensUsed = new[] { 185000, 132000, 94000, 0, 0 };
    var demoCostUsed = new[] { 3.70m, 2.64m, 1.88m, 0m, 0m };
    var demoHoursUsed = new[] { 12, 9, 7, 0, 0 };

    var descriptions = new Dictionary<string, string> {
        ["discovery"] = "Turn a product idea into approved requirements, features and task specifications.",
        ["design"] = "Transform approved requirements into responsive, reviewable screens.",
        ["development"] = "Explore the implementation plan, source files and build output.",
        ["quality"] = "Review test scenarios, execution results and defects.",
        ["deployment"] = "Prepare environments, review releases and inspect deployment health."
    };
}
<link rel="stylesheet" href="~/css/lifecycle-workspace.css" asp-append-version="true" />
<div class="lf-root" data-lifecycle-stage="@stageKey">
    <div class="lf-overview-grid @(stageKey == "board" || stageKey == "specifications" ? "lf-overview-grid--single" : "")">
    <header class="lf-project-header ui-panel">
        <div class="lf-project-identity">
            <span class="lf-project-icon" aria-hidden="true">@if (stageKey == "board") { <svg viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M9 3v18" /></svg> } else if (stageKey == "specifications") { <svg viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l4 4v14H6zM15 3v5h4M9 12h7M9 16h7" /></svg> } else if (stageIconPaths.TryGetValue(stageKey, out var stageIconPath)) { <svg viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="@stageIconPath" /></svg> } else { <span>▦</span> }</span>
            <div class="lf-project-details">
                <div class="lf-project-title"><strong>@(stageKey == "board" ? "Project Board" : stageKey == "specifications" ? "Project Specifications" : projectName)</strong><span class="lf-project-status">Demo workspace</span></div>
                <p>@(stageKey == "board" ? $"{projectName} · Track work from new requests through delivery." : stageKey == "specifications" ? $"{projectName} · Browse uploaded and Agent project documents." : "Lifecycle progress · sample values")</p>

            </div>
            @if (stageIndex >= 0)
            {
                <div class="lf-lifecycle-usage" aria-label="Illustrative stage usage">
                    <span title="Time spent">⏱ @demoHoursUsed[stageIndex]h</span>
                    <span title="Tokens used">◈ @((demoTokensUsed[stageIndex] / 1000.0).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))K</span>
                    <span title="AI cost">$ @demoCostUsed[stageIndex].ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</span>
                </div>
            }
            @if (stageKey == "specifications")
            {
                <button class="lf-doc-upload" type="button" data-lf-doc-demo-action="Upload">+ Upload document</button>
            }
            @if (stageKey == "board")
            {
            <div class="lf-board-view-toolbar" role="group" aria-label="Board display mode">
                <button type="button" class="is-active" data-lf-board-view="kanban" aria-pressed="true">Board</button>
                <button type="button" data-lf-board-view="features" aria-pressed="false">Features</button>
            </div>
            }
        </div>
        @if (stageKey != "board" && stageKey != "specifications")
        {
        <nav class="lf-progress-timeline" aria-label="Engineering lifecycle">
            <ol class="lf-progress-track">
                @for (var i = 0; i < stages.Length; i++)
                {
                    var stage = stages[i];
                    var isCurrent = i == stageIndex;
                    var isEarlier = stageIndex >= 0 && i < stageIndex;
                    var samplePercent = demoProgress[i];
                    <li class="lf-progress-item @(isCurrent ? "is-current" : isEarlier ? "is-earlier" : "is-upcoming")">
                        <a class="lf-progress-link" href="/projects/@projectId/@stage.Item1" aria-current="@(isCurrent ? "step" : null)" aria-label="Go to @stage.Item2">
                            <span class="lf-progress-node" aria-hidden="true">@(i + 1)</span>
                            <span class="lf-progress-name">@stage.Item2</span>
                            <span class="lf-progress-percent">@samplePercent%</span>
                        </a>
                    </li>
                }
            </ol>
        </nav>
        }

    </header>
    </div>
    @if (stageIndex >= 0)
    {
        <div class="lf-split">
            <section class="lf-chat lf-card ui-panel" aria-label="@agent demo conversation">
                <div class="lf-panel-head"><div><strong>@agent</strong><small>Guided workspace conversation</small></div><span class="lf-pill">Demo</span></div>
                <div class="lf-messages" id="lfMessages" aria-live="polite">
                    @if (stageKey == "discovery")
                    {
                        <div class="lf-message lf-agent">Hi! I'll help turn your idea into a product plan. What problem are we solving, and who is it for?</div>
                        <div class="lf-message lf-user">I want a healthcare appointment booking platform for patients and doctors.</div>
                        <div class="lf-message lf-agent">I've drafted the business requirements, a feature backlog and task-level acceptance criteria. Review the artifacts on the right before approving.</div>
                    }
                    else if (stageKey == "design")
                    {
                        <div class="lf-message lf-agent">I've translated the booking requirements into a responsive appointment booking screen. You can inspect the desktop and mobile previews.</div>
                        <div class="lf-message lf-user">Make it easy to find a doctor and book an appointment.</div>
                        <div class="lf-message lf-agent">The prototype includes search, specialties and a clear booking action. These are sample designs, not generated or saved files.</div>
                    }
                    else if (stageKey == "development")
                    {
                        <div class="lf-message lf-agent">Here's a representative project tree and implementation excerpt for the appointment feature.</div>
                        <div class="lf-message lf-user">Implement appointment booking and validate the input.</div>
                        <div class="lf-message lf-agent">The file explorer and terminal on the right demonstrate how a real engineering run could be presented. No code has been executed.</div>
                    }
                    else if (stageKey == "quality")
                    {
                        <div class="lf-message lf-agent">I prepared test cases from the acceptance criteria: successful booking, unavailable slot, invalid patient and cancellation window.</div>
                        <div class="lf-message lf-user">Show me failed scenarios first.</div>
                        <div class="lf-message lf-agent">The sample report highlights two failures and links them back to their feature. These results are illustrative, not executed tests.</div>
                    }
                    else
                    {
                        <div class="lf-message lf-agent">We can configure a preview environment, inspect deployment readiness and approve a release.</div>
                        <div class="lf-message lf-user">Show me the preview deployment status.</div>
                        <div class="lf-message lf-agent">The right panel shows example environments and a release checklist. No deployment has occurred.</div>
                    }
                </div>
                <form class="lf-composer" id="lfDemoChat"><label class="lf-sr-only" for="lfPrompt">Demo message</label><input id="lfPrompt" autocomplete="off" placeholder="Ask @agent…" /><button type="submit">Send</button></form>
            </section>
            <section class="lf-artifacts lf-card ui-panel" aria-label="Stage artifacts">
                <div class="lf-panel-head"><div><strong>@(stageKey == "discovery" ? "Discovery artifacts" : stageKey == "design" ? "Design studio" : stageKey == "development" ? "Code workspace" : stageKey == "quality" ? "Quality reports" : "Release center")</strong><small>Healthcare Booking · sample project</small></div>@if (stageKey == "discovery") { <button type="button" class="lf-discovery-preview-button" data-lf-discovery-preview>Preview</button> } else { <span class="lf-pill">v0.1 · Sample</span> }</div>
                @if (stageKey == "discovery")
                {
                    <div class="lf-discovery-document" aria-label="Discovery Word document">
                        <article class="lf-discovery-paper" aria-label="Business requirements document preview">
                            <h2>Healthcare Appointment Platform</h2>
                            <p class="lf-muted">Business requirements · version 0.1</p>
                            <h3>Problem statement</h3>
                            <p>Patients need a simple way to discover healthcare providers, see available slots and manage bookings without calling a clinic.</p>
                            <h3>Target users</h3>
                            <p>Patients, healthcare providers and clinic administrators.</p>
                            <h3>Business goals</h3>
                            <ul><li>Reduce friction when scheduling appointments.</li><li>Prevent double bookings.</li><li>Allow cancellation at least 24 hours before an appointment.</li></ul>
                            <h3>Success criteria</h3>
                            <p>A patient can discover a doctor, select a free slot and receive confirmation.</p>
                        </article>
                    </div>
                    <dialog class="lf-discovery-dialog" data-lf-discovery-dialog aria-label="Discovery document preview">
                        <div class="lf-discovery-dialog-head"><strong>Document preview</strong><button type="button" data-lf-discovery-close aria-label="Close preview">✕</button></div>
                        <div class="lf-discovery-document"><article class="lf-discovery-paper" aria-label="Business requirements document preview">
                            <h2>Healthcare Appointment Platform</h2>
                            <p class="lf-muted">Business requirements · version 0.1</p>
                            <h3>Problem statement</h3>
                            <p>Patients need a simple way to discover healthcare providers, see available slots and manage bookings without calling a clinic.</p>
                            <h3>Target users</h3>
                            <p>Patients, healthcare providers and clinic administrators.</p>
                            <h3>Business goals</h3>
                            <ul><li>Reduce friction when scheduling appointments.</li><li>Prevent double bookings.</li><li>Allow cancellation at least 24 hours before an appointment.</li></ul>
                            <h3>Success criteria</h3>
                            <p>A patient can discover a doctor, select a free slot and receive confirmation.</p>
                        </article></div>
                    </dialog>
                }
                else if (stageKey == "design")
                {
                    <div class="lf-tabs" role="tablist" aria-label="Design outputs"><button type="button" class="is-active" data-lf-tab="preview">Live mockup</button><button type="button" data-lf-tab="design-files">Design files</button></div>
                    <div class="lf-tab-panel" data-lf-panel="preview"><div class="lf-preview-toolbar"><span>Appointment booking · FEAT-003</span><div><button type="button" class="is-active" data-lf-viewport="desktop">Desktop</button><button type="button" data-lf-viewport="mobile">Mobile</button></div></div><div class="lf-browser"><div class="lf-browser-bar">● ● ● <span>healthcare.example / appointments</span></div><div class="lf-website"><header><strong>✚ CareConnect</strong><span>Find doctors &nbsp; Appointments &nbsp; Profile</span></header><div class="lf-hero"><div><span class="lf-pill">Find care faster</span><h2>Book your next appointment</h2><p>Find trusted providers and available appointments in minutes.</p><div class="lf-searchbox">Search doctors or specialties <span>Search</span></div></div><div class="lf-hero-graphic">✚</div></div><h3>Popular specialties</h3><div class="lf-specialties"><span>♡ General medicine</span><span>◈ Dermatology</span><span>♡ Cardiology</span><span>✦ Pediatrics</span></div></div></div><p class="lf-muted">Static HTML/CSS mockup. Search and booking are not functional.</p></div>
                    <div class="lf-tab-panel" data-lf-panel="design-files" hidden><div class="lf-file-list"><div>▣ &nbsp; screens/booking.html <span>HTML mockup</span></div><div>◈ &nbsp; styles/tokens.css <span>Design tokens</span></div><div>▤ &nbsp; components/search-bar <span>UI component</span></div><div>▧ &nbsp; flows/appointment-booking <span>User journey</span></div></div><div class="lf-spec"><h3>Design decisions</h3><p>Responsive two-column hero, prominent search, accessible contrast and a clear appointment booking action.</p></div></div>
                }
                else if (stageKey == "development")
                {
                    <div class="lf-code-layout"><aside class="lf-file-tree"><strong>EXPLORER</strong><div>▾ healthcare-app</div><div>　▾ src</div><button type="button" class="is-active" data-lf-file="booking">　　booking.ts</button><button type="button" data-lf-file="service">　　availability.ts</button><div>　　components/</div><div>　▸ tests/</div><div>　package.json</div></aside><div class="lf-editor"><div class="lf-editor-head" id="lfFilename">booking.ts · TASK-011</div><pre data-lf-code="booking"><code>export type BookingRequest = {
  patientId: string;
  providerId: string;
  slotId: string;
};

export async function book(
  request: BookingRequest
) {
  if (!request.slotId) {
    throw new Error("Slot required");
  }
  return bookingApi.create(request);
}</code></pre><pre data-lf-code="service" hidden><code>export async function getAvailableSlots(
  providerId: string
) {
  return availabilityApi.list({
    providerId,
    futureOnly: true
  });
}</code></pre><div class="lf-terminal"><strong>TERMINAL · SAMPLE OUTPUT</strong><p>$ npm run build</p><p class="lf-terminal-ok">✓ Build completed · illustrative</p><p>$ npm test</p><p class="lf-terminal-ok">✓ 22 passed · illustrative</p></div></div></div><p class="lf-muted">Source excerpts and terminal output are mock data; no repository was generated or built.</p>
                }
                else if (stageKey == "quality")
                {
                    <div class="lf-stat-row"><div><strong>24</strong><small>Example tests</small></div><div><strong>22</strong><small>Passed</small></div><div><strong>2</strong><small>Failed</small></div><div><strong>92%</strong><small>Pass rate</small></div></div><div class="lf-tabs" role="tablist" aria-label="Quality outputs"><button type="button" class="is-active" data-lf-tab="results">Test results</button><button type="button" data-lf-tab="cases">Test scenarios</button><button type="button" data-lf-tab="defects">Defects</button></div><div class="lf-tab-panel" data-lf-panel="results"><table class="lf-table"><thead><tr><th>Test</th><th>Type</th><th>Status</th></tr></thead><tbody><tr><td>Patient sign-in</td><td>Unit</td><td class="lf-pass">Passed</td></tr><tr><td>Booking available slot</td><td>Integration</td><td class="lf-pass">Passed</td></tr><tr><td>Cancellation after cutoff</td><td>Integration</td><td class="lf-fail">Failed</td></tr><tr><td>Concurrent slot booking</td><td>Integration</td><td class="lf-fail">Failed</td></tr><tr><td>Responsive booking page</td><td>E2E</td><td class="lf-pass">Passed</td></tr></tbody></table></div><div class="lf-tab-panel" data-lf-panel="cases" hidden><div class="lf-spec"><h3>Acceptance-criteria driven scenarios</h3><ol><li>Patient books an available future slot.</li><li>Patient cannot book a past slot.</li><li>Second patient cannot reserve an already booked slot.</li><li>Cancellation is blocked inside the 24-hour cutoff.</li><li>Booking confirmation is visible on mobile.</li></ol></div></div><div class="lf-tab-panel" data-lf-panel="defects" hidden><div class="lf-spec"><span class="lf-pill lf-red">DEF-001 · High</span><h3>Cancellation cutoff not enforced</h3><p>Related to TASK-011 / FEAT-003. Expected: reject cancellations less than 24 hours before start.</p></div><div class="lf-spec"><span class="lf-pill lf-red">DEF-002 · High</span><h3>Concurrent booking conflict</h3><p>Related to TASK-011 / FEAT-003. Expected: only one reservation can claim the slot.</p></div></div><p class="lf-muted">All results and defects are fictional demo data. No tests have run.</p>
                }
                else
                {
                    <div class="lf-stat-row"><div><strong>Preview</strong><small>Sample active</small></div><div><strong>Staging</strong><small>Sample ready</small></div><div><strong>Production</strong><small>Not deployed</small></div></div><div class="lf-tabs" role="tablist" aria-label="Deployment outputs"><button type="button" class="is-active" data-lf-tab="environments">Environments</button><button type="button" data-lf-tab="release">Release checklist</button><button type="button" data-lf-tab="logs">Logs</button></div><div class="lf-tab-panel" data-lf-panel="environments"><div class="lf-env"><div><strong>Preview</strong><p>Sample preview environment · v0.1.0</p></div><span class="lf-pill lf-green">Illustrative</span></div><div class="lf-env"><div><strong>Staging</strong><p>Awaiting QA sign-off</p></div><span class="lf-pill">Pending</span></div><div class="lf-env"><div><strong>Production</strong><p>No release deployed</p></div><span class="lf-pill lf-red">Not deployed</span></div></div><div class="lf-tab-panel" data-lf-panel="release" hidden><div class="lf-spec"><h3>Release v0.1.0</h3><ul><li>✓ Business requirements approved (sample)</li><li>✓ Design reviewed (sample)</li><li>✓ Build artifact prepared (sample)</li><li>⚠ Two QA failures require resolution</li><li>○ Production approval pending</li></ul><button type="button" class="lf-disabled-action" disabled>Deploy to production · demo only</button></div></div><div class="lf-tab-panel" data-lf-panel="logs" hidden><div class="lf-terminal lf-standalone"><strong>EXAMPLE RELEASE LOG</strong><p>10:01:02 Checking deployment configuration…</p><p>10:01:04 Preview health check: OK (sample)</p><p>10:01:05 Production release: not started</p></div></div><p class="lf-muted">No hosting provider, credentials, live URLs or deployment actions are connected.</p>
                }
            </section>
        </div>
        <div class="lf-bottom"><span>Shared artifacts: BRD-001 → FEAT-003 → TASK-011 → Design → Code → Tests → Release</span>@if (stageIndex < stages.Length - 1) { <a href="/projects/@projectId/@stages[stageIndex + 1].Item1">Explore @stages[stageIndex + 1].Item2 →</a> } else { <a href="/projects/@projectId/discovery">Return to Discovery ↺</a> }</div>
    }
    else if (stageKey == "board")
    {
        <section class="lf-board-workspace" aria-label="Project work views">
            <div class="lf-board-view" data-lf-board-panel="kanban">
            <section class="lf-board-layout" aria-label="Project Kanban board">
            <div class="lf-board-columns">
                <section class="lf-board-column ui-panel" aria-label="New, 2 tasks">
                    <div class="lf-board-column-head"><h2><span class="lf-board-status-dot is-new"></span>New</h2><span class="lf-board-count">2</span></div>
                    <div class="lf-board-task-list">
                            <article class="lf-board-task"><h3 class="lf-board-task-heading"><span class="lf-board-task-id">TASK-013</span> Implement appointment reminders</h3><div class="lf-board-task-feature"><span class="lf-board-feature">FEAT-004 · Notifications</span></div><div class="lf-board-task-stats" aria-label="Illustrative task usage"><span title="Time spent">⏱ 0h</span><span title="Tokens used">◈ 0</span><span title="AI cost">$ 0.00</span></div></article>
                            <article class="lf-board-task"><h3 class="lf-board-task-heading"><span class="lf-board-task-id">TASK-014</span> Create reminder scheduling</h3><div class="lf-board-task-feature"><span class="lf-board-feature">FEAT-004 · Notifications</span></div><div class="lf-board-task-stats" aria-label="Illustrative task usage"><span title="Time spent">⏱ 0h</span><span title="Tokens used">◈ 0</span><span title="AI cost">$ 0.00</span></div></article>
                        </div>
                </section>
                <section class="lf-board-column ui-panel" aria-label="In Progress, 2 tasks">
                    <div class="lf-board-column-head"><h2><span class="lf-board-status-dot is-progress"></span>In Progress</h2><span class="lf-board-count">2</span></div>
                    <div class="lf-board-task-list">
                            <article class="lf-board-task"><h3 class="lf-board-task-heading"><span class="lf-board-task-id">TASK-009</span> Build doctor search API</h3><div class="lf-board-task-feature"><span class="lf-board-feature">FEAT-002 · Doctor Search</span></div><div class="lf-board-task-stats" aria-label="Illustrative task usage"><span title="Time spent">⏱ 3.5h</span><span title="Tokens used">◈ 42K</span><span title="AI cost">$ 0.84</span></div></article>
                            <article class="lf-board-task"><h3 class="lf-board-task-heading"><span class="lf-board-task-id">TASK-010</span> Implement availability UI</h3><div class="lf-board-task-feature"><span class="lf-board-feature">FEAT-002 · Doctor Search</span></div><div class="lf-board-task-stats" aria-label="Illustrative task usage"><span title="Time spent">⏱ 2h</span><span title="Tokens used">◈ 25K</span><span title="AI cost">$ 0.50</span></div></article>
                        </div>
                </section>
                <section class="lf-board-column ui-panel" aria-label="Review, 2 tasks">
                    <div class="lf-board-column-head"><h2><span class="lf-board-status-dot is-review"></span>Review</h2><span class="lf-board-count">2</span></div>
                    <div class="lf-board-task-list">
                            <article class="lf-board-task"><h3 class="lf-board-task-heading"><span class="lf-board-task-id">TASK-011</span> Implement booking API</h3><div class="lf-board-task-feature"><span class="lf-board-feature">FEAT-003 · Booking</span></div><div class="lf-board-task-stats" aria-label="Illustrative task usage"><span title="Time spent">⏱ 5.2h</span><span title="Tokens used">◈ 68K</span><span title="AI cost">$ 1.36</span></div></article>
                            <article class="lf-board-task"><h3 class="lf-board-task-heading"><span class="lf-board-task-id">TASK-012</span> Build responsive booking UI</h3><div class="lf-board-task-feature"><span class="lf-board-feature">FEAT-003 · Booking</span></div><div class="lf-board-task-stats" aria-label="Illustrative task usage"><span title="Time spent">⏱ 1.8h</span><span title="Tokens used">◈ 22K</span><span title="AI cost">$ 0.44</span></div></article>
                        </div>
                </section>
                <section class="lf-board-column ui-panel" aria-label="Quality, 1 tasks">
                    <div class="lf-board-column-head"><h2><span class="lf-board-status-dot is-quality"></span>Quality</h2><span class="lf-board-count">1</span></div>
                    <div class="lf-board-task-list">
                            <article class="lf-board-task"><h3 class="lf-board-task-heading"><span class="lf-board-task-id">QA-001</span> Validate booking scenarios</h3><div class="lf-board-task-feature"><span class="lf-board-feature">FEAT-003 · Booking</span></div><div class="lf-board-task-stats" aria-label="Illustrative task usage"><span title="Time spent">⏱ 2.1h</span><span title="Tokens used">◈ 18K</span><span title="AI cost">$ 0.36</span></div></article>
                        </div>
                </section>
                <section class="lf-board-column ui-panel" aria-label="Done, 2 tasks">
                    <div class="lf-board-column-head"><h2><span class="lf-board-status-dot is-done"></span>Done</h2><span class="lf-board-count">2</span></div>
                    <div class="lf-board-task-list">
                            <article class="lf-board-task"><h3 class="lf-board-task-heading"><span class="lf-board-task-id">TASK-007</span> Implement authentication flow</h3><div class="lf-board-task-feature"><span class="lf-board-feature">FEAT-001 · Authentication</span></div><div class="lf-board-task-stats" aria-label="Illustrative task usage"><span title="Time spent">⏱ 4.8h</span><span title="Tokens used">◈ 51K</span><span title="AI cost">$ 1.02</span></div></article>
                            <article class="lf-board-task"><h3 class="lf-board-task-heading"><span class="lf-board-task-id">TASK-008</span> Build profile management</h3><div class="lf-board-task-feature"><span class="lf-board-feature">FEAT-001 · Authentication</span></div><div class="lf-board-task-stats" aria-label="Illustrative task usage"><span title="Time spent">⏱ 2.6h</span><span title="Tokens used">◈ 29K</span><span title="AI cost">$ 0.58</span></div></article>
                        </div>
                </section>
            </div>
            <p class="lf-board-note">Sample tasks and usage estimates only · no measured telemetry, persistence or drag-and-drop.</p>
        </section>
