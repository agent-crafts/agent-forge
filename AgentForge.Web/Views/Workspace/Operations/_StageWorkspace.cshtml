@{ var stageKey = (string)ViewData["WorkspaceStage"]!; var projectId = (string)ViewData["ProjectId"]!; var stages = new[] {("discovery","Discovery"),("design","Design"),("development","Development"),("quality","Quality"),("deployment","Deployment")}; var stageIndex = Array.FindIndex(stages,x=>x.Item1==stageKey); var agent = stageKey switch { "discovery"=>"Explorer", "design"=>"Designer", "development"=>"Builder", "quality"=>"Validator", _=>"Launcher" }; }
