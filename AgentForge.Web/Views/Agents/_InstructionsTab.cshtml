@model AgentForge.Web.Controllers.AgentsController.AgentCard
<section class="ui-panel agent-instructions">
    <h2>System Instructions</h2>
    <p class="ui-subtitle">Write instructions in Markdown. Use the editor toolbar, side-by-side preview, or full-screen mode.</p>
    <form id="agentInstructionsForm" data-agent-id="@Model.Id">
        @Html.AntiForgeryToken()
        <label for="agentSystemInstructions" class="ui-field-label">System Instructions</label>
        <partial name="_MarkdownEditor" model='"agentSystemInstructions"' view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["MarkdownContent"] = Model.SystemInstructions }' />
        <div class="mt-4 flex items-center gap-3">
            <button id="saveAgentInstructions" type="submit" class="ui-button ui-button--primary">Save Changes</button>
            <span id="agentInstructionsFeedback" role="status" aria-live="polite"></span>
        </div>
    </form>
</section>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde@2.20.0/dist/easymde.min.css" />
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.2.6/dist/purify.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/easymde@2.20.0/dist/easymde.min.js"></script>
<script src="~/js/shared/markdown-editor.js" asp-append-version="true"></script>
<script src="~/js/agents/agent-instructions.js" asp-append-version="true"></script>
