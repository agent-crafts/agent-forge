@model AgentForge.Web.Controllers.AgentsController.AgentCard
<div class="agent-overview-layout">
    <div class="ui-stack">
        <section class="ui-panel">
            <h2><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9"/><path d="M8 3h7l6 6h-6V3M8 13h8M8 17h8"/></svg></span> System instructions</h2>
            <p class="ui-subtitle">Illustrative draft based on the sample agent description. Not a saved or active system prompt.</p>
            <div class="ui-note">
                <strong>Draft instruction preview</strong>
                <p>You are @Model.Name. Your purpose is to: @Model.Description</p>
                <p>Explain your reasoning at a useful level, identify assumptions, and ask for clarification when requirements are ambiguous. Do not claim actions were completed without evidence.</p>
            </div>
        </section>
        <section class="ui-panel">
            <h2><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="m8 10 2 2 4-4M8 17h8"/></svg></span> Responsibilities</h2>
            <p class="ui-subtitle">Sample capabilities that can inform future instructions.</p>
            <ul class="agent-feature-list">
                @foreach (var capability in Model.Tags)
                {
                    <li>@capability</li>
                }
            </ul>
        </section>
    </div>
    <div class="ui-stack">
        <section class="ui-panel">
            <h2><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 7v5c0 5 3.5 8 8 9 4.5-1 8-4 8-9V7l-8-4Z"/><path d="m9 12 2 2 4-4"/></svg></span> Behavior guidelines</h2>
            <ul class="agent-feature-list">
                <li>Follow the task and clarify missing requirements.</li>
                <li>Describe assumptions and limitations.</li>
                <li>Report outcomes accurately.</li>
            </ul>
        </section>
        <section class="ui-panel">
            <h2><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 2 21h20L12 3Z"/><path d="M12 9v5M12 17h.01"/></svg></span> Boundaries</h2>
            <p>Tool permissions, approval requirements, and runtime guardrails have not been configured for this sample agent.</p>
        </section>
        <section class="ui-panel">
            <h2><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg></span> Preview only</h2>
            <p>These instructions are examples for UI design. Editing, persistence, and runtime enforcement are not implemented.</p>
        </section>
    </div>
</div>
