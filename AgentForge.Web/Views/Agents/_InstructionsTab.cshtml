@model AgentForge.Web.Controllers.AgentsController.AgentCard
<section class="ui-panel agent-instructions">
    <h2><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9"/><path d="M8 3h7l6 6h-6V3M8 13h8M8 17h8"/></svg></span> System Prompt</h2>
    <div class="agent-instructions-body">
        <p class="ui-subtitle">Instructions describing the agent's role, responsibilities, guidelines, and constraints.</p>
        <div class="agent-prompt-preview" role="region" aria-label="Saved system instructions" tabindex="0">
            <pre style="white-space:pre-wrap;overflow-wrap:anywhere">@Model.SystemInstructions</pre>
        </div>
    </div>
</section>
