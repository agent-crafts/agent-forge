@model AgentForge.Web.Controllers.AgentsController.AgentCard
<div class="agent-overview-layout">
        <div class="ui-stack">
            <section class="ui-panel">
                <h2><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z"/><path d="M12 11v5M12 8h.01"/></svg></span> About this agent</h2>
                <p>@Model.Description</p>
            </section>
            <section class="ui-panel">
                <h2><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12V5a2 2 0 0 1 2-2h7l9 9-9 9-9-9Z"/><circle cx="8" cy="8" r="1"/></svg></span> Tags</h2>
                <div class="ui-tags">
                    <span>@Model.Category</span>
                    @foreach (var tag in Model.Tags)
                    {
                        <span>@tag</span>
                    }
                </div>
            </section>
        </div>
        <div class="ui-stack">
            <section class="ui-panel">
                <h2><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span> Agent information</h2>
                <dl class="agent-info-list">
                    <div><dt>Category</dt><dd>@Model.Category</dd></div>
                    <div><dt>Created</dt><dd><time datetime="@Model.CreatedAt.ToString("O")" title="@Model.CreatedAt.ToString("u")">@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm") UTC</time></dd></div>
                    <div><dt>Last updated</dt><dd><time datetime="@Model.UpdatedAt.ToString("O")" title="@Model.UpdatedAt.ToString("u")">@Model.UpdatedAt.ToString("dd MMM yyyy, HH:mm") UTC</time></dd></div>
                    <div><dt>Status</dt><dd>@(Model.IsActive ? "Active" : "Inactive")</dd></div>
                    <div><dt>Agent ID</dt><dd class="break-all">@Model.Id</dd></div>
                </dl>
            </section>
        </div>
    </div>
