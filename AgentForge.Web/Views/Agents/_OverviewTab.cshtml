@model AgentForge.Web.Controllers.AgentsController.AgentCard
<div class="agent-overview-layout">
        <div class="ui-stack">
            <section class="ui-panel">
                <h2><span class="ui-panel-icon" aria-hidden="true">✦</span> About this agent</h2>
                <p>@Model.Description</p>
                <div class="ui-note">
                    <strong>Key features</strong>
                    <ul class="agent-feature-list">
                        @foreach (var capability in Model.Tags)
                        {
                            <li>@capability</li>
                        }
                    </ul>
                </div>
            </section>
            <section class="ui-panel">
                <h2><span class="ui-panel-icon" aria-hidden="true">✧</span> Capabilities</h2>
                <div class="agent-capability-grid">
                    @foreach (var capability in Model.Tags)
                    {
                        <div class="agent-capability-card">
                            <span class="agent-capability-symbol" aria-hidden="true">✦</span>
                            <div><strong>@capability</strong><p>Part of this agent's sample capabilities.</p></div>
                        </div>
                    }
                </div>
            </section>
            <section class="ui-panel">
                <h2><span class="ui-panel-icon" aria-hidden="true">☑</span> Typical use cases</h2>
                <ol class="agent-use-cases">
                    @foreach (var capability in Model.Tags)
                    {
                        <li>Tasks involving @capability.ToLowerInvariant()</li>
                    }
                </ol>
            </section>
        </div>
        <div class="ui-stack">
            <section class="ui-panel">
                <h2><span class="ui-panel-icon" aria-hidden="true">☷</span> Agent information</h2>
                <dl class="agent-info-list">
                    <div><dt>Category</dt><dd>@Model.Category</dd></div>
                    <div><dt>Type</dt><dd>Sample agent</dd></div>
                    <div><dt>Agent ID</dt><dd>@Model.Id</dd></div>
                    <div><dt>Execution</dt><dd>Not available</dd></div>
                </dl>
            </section>
            <section class="ui-panel">
                <h2><span class="ui-panel-icon" aria-hidden="true">⌗</span> Tags</h2>
                <div class="ui-tags">
                    <span>@Model.Category</span>
                    @foreach (var tag in Model.Tags)
                    {
                        <span>@tag</span>
                    }
                </div>
            </section>
            <section class="ui-panel">
                <h2><span class="ui-panel-icon" aria-hidden="true">ⓘ</span> Preview status</h2>
                <p>This is a static sample agent. Model configuration, connected tools, execution history, and runtime settings are not available yet.</p>
            </section>
        </div>
    </div>
</div>
