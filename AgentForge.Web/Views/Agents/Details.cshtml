@model AgentForge.Web.Controllers.AgentsController.AgentCard
@{
    Layout = "_AppLayout";
}
<div class="ui-detail">
    <nav class="mb-4 text-sm text-muted" aria-label="Breadcrumb">
        <a href="/agents" class="text-muted hover:text-heading">Agents</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page" class="text-heading">@Model.Name</span>
    </nav>
    <section class="ui-profile">
        <div class="ui-profile-icon" aria-hidden="true"><span class="text-2xl">@Model.Icon</span></div>
        <div class="ui-profile-main">
            <div class="ui-profile-title"><h1>@Model.Name</h1></div>
            <p>@Model.Description</p>
            <div class="ui-tags"><span>@Model.Category</span><span>Sample agent</span></div>
        </div>
    </section>
    <div class="ui-columns mt-6">
        <div class="ui-stack">
            <section class="ui-panel">
                <h2>Overview</h2>
                <p class="ui-subtitle">What this agent is designed to help with.</p>
                <p>@Model.Description</p>
            </section>
        </div>
        <div class="ui-stack">
            <section class="ui-panel">
                <h2>Capabilities</h2>
                <p class="ui-subtitle">Capabilities shown in this preview.</p>
                <div class="ui-tags">
                    @foreach (var tag in Model.Tags)
                    {
                        <span>@tag</span>
                    }
                </div>
            </section>
            <section class="ui-panel">
                <h2>Availability</h2>
                <p>This is a sample agent profile. Configuration and execution are not available yet.</p>
            </section>
        </div>
    </div>
</div>
