@model AgentForge.Web.Controllers.AgentsController.AgentCard
@{
    Layout = "_AppLayout";
}
<div class="ui-detail">
    <section class="ui-profile ui-tool-profile">
        <div class="ui-tool-actions" role="group" aria-label="Agent actions">
            <button type="button" class="ui-button ui-tool-action ui-tool-action--edit" aria-label="Edit agent (coming soon)" title="Edit agent — coming soon" disabled aria-disabled="true"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L9 17l-4 1 1-4Z"/></svg></button>
            <button type="button" class="ui-button ui-tool-action ui-tool-action--delete" aria-label="Delete agent (coming soon)" title="Delete agent — coming soon" disabled aria-disabled="true"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M5 6l1 14h12l1-14M10 10v7M14 10v7"/></svg></button>
        </div>
        <div class="ui-profile-icon" aria-hidden="true"><span class="text-2xl">@Model.Icon</span></div>
        <div class="ui-profile-main">
            <div class="ui-profile-title"><h1>@Model.Name</h1></div>
            <p>@Model.Description</p>
            <div class="ui-tags"><span>@Model.Id</span><span>@Model.Category</span><span>Sample agent</span></div>
        </div>
    </section>
    <div class="mt-6 flex gap-2 border-b border-line" role="tablist" aria-label="Agent details sections">
        <button type="button" id="agentOverviewTab" role="tab" aria-controls="agentOverviewPanel" aria-selected="true" tabindex="0" class="border-b-2 border-accent px-5 py-3 text-sm font-semibold text-heading">Overview</button>
        <button type="button" id="agentCapabilitiesTab" role="tab" aria-controls="agentCapabilitiesPanel" aria-selected="false" tabindex="-1" class="border-b-2 border-transparent px-5 py-3 text-sm font-semibold text-muted">Capabilities</button>
    </div>
    <div id="agentOverviewPanel" role="tabpanel" aria-labelledby="agentOverviewTab">
        <div class="agent-overview-layout">
            <div class="ui-stack">
                <section class="ui-panel">
                    <h2><span class="ui-panel-icon" aria-hidden="true">✦</span> About this agent</h2>
                    <p>@Model.Description</p>
                    <div class="ui-note">
                        <strong>Key features</strong>
                        <ul class="agent-feature-list">
                            @foreach (var capability in Model.Tags)
                            {
                                <li>@capability</li>
                            }
                        </ul>
                    </div>
                </section>
                <section class="ui-panel">
                    <h2><span class="ui-panel-icon" aria-hidden="true">✧</span> Capabilities</h2>
                    <div class="agent-capability-grid">
                        @foreach (var capability in Model.Tags)
                        {
                            <div class="agent-capability-card">
                                <span class="agent-capability-symbol" aria-hidden="true">✦</span>
                                <div><strong>@capability</strong><p>Part of this agent's sample capabilities.</p></div>
                            </div>
                        }
                    </div>
                </section>
                <section class="ui-panel">
                    <h2><span class="ui-panel-icon" aria-hidden="true">☑</span> Typical use cases</h2>
                    <ol class="agent-use-cases">
                        @foreach (var capability in Model.Tags)
                        {
                            <li>Tasks involving @capability.ToLowerInvariant()</li>
                        }
                    </ol>
                </section>
            </div>
            <div class="ui-stack">
                <section class="ui-panel">
                    <h2><span class="ui-panel-icon" aria-hidden="true">☷</span> Agent information</h2>
                    <dl class="agent-info-list">
                        <div><dt>Category</dt><dd>@Model.Category</dd></div>
                        <div><dt>Type</dt><dd>Sample agent</dd></div>
                        <div><dt>Agent ID</dt><dd>@Model.Id</dd></div>
                        <div><dt>Execution</dt><dd>Not available</dd></div>
                    </dl>
                </section>
                <section class="ui-panel">
                    <h2><span class="ui-panel-icon" aria-hidden="true">⌗</span> Tags</h2>
                    <div class="ui-tags">
                        <span>@Model.Category</span>
                        @foreach (var tag in Model.Tags)
                        {
                            <span>@tag</span>
                        }
                    </div>
                </section>
                <section class="ui-panel">
                    <h2><span class="ui-panel-icon" aria-hidden="true">ⓘ</span> Preview status</h2>
                    <p>This is a static sample agent. Model configuration, connected tools, execution history, and runtime settings are not available yet.</p>
                </section>
            </div>
        </div>
    </div>
    <div id="agentCapabilitiesPanel" role="tabpanel" aria-labelledby="agentCapabilitiesTab" hidden>
        <div class="ui-columns">
            <div class="ui-stack">
                <section class="ui-panel">
                    <h2>Capabilities</h2>
                    <p class="ui-subtitle">Capabilities shown in this preview.</p>
                    <div class="ui-tags">
                        @foreach (var tag in Model.Tags)
                        {
                            <span>@tag</span>
                        }
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>
<script>
(() => {
    const tabs = [document.getElementById('agentOverviewTab'), document.getElementById('agentCapabilitiesTab')];
    const panels = [document.getElementById('agentOverviewPanel'), document.getElementById('agentCapabilitiesPanel')];
    tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
            tabs.forEach((item, i) => {
                const active = i === index;
                item.setAttribute('aria-selected', String(active));
                item.tabIndex = active ? 0 : -1;
                item.classList.toggle('border-accent', active);
                item.classList.toggle('border-transparent', !active);
                item.classList.toggle('text-heading', active);
                item.classList.toggle('text-muted', !active);
                panels[i].hidden = !active;
            });
        });
        tab.addEventListener('keydown', event => {
            if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
            event.preventDefault();
            const next = (index + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length;
            tabs[next].focus();
            tabs[next].click();
        });
    });
})();
</script>
