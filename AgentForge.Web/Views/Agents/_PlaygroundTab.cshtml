@model AgentForge.Web.Controllers.AgentsController.AgentCard
@{
    var assignedToolCount = (ViewData["AssignedAgentToolIds"] as HashSet<Guid>)?.Count ?? 0;
}
<script src="https://cdn.jsdelivr.net/npm/marked@15.0.12/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.2.6/dist/purify.min.js"></script>
<style>
.agent-playground .af-message--assistant .af-message__body { overflow-wrap:anywhere; white-space:normal; line-height:1.65; }
.agent-playground .af-message--assistant .af-message__body > :first-child { margin-top:0; }
.agent-playground .af-message--assistant .af-message__body > :last-child { margin-bottom:0; }
.agent-playground .af-message--assistant .af-message__body p { margin:.45em 0; }
.agent-playground .af-message--assistant .af-message__body li { margin:.2em 0; padding:0; }
.agent-playground .af-message--assistant .af-message__body li > p { margin:.2em 0; }
.agent-playground .af-message--assistant .af-message__body pre { white-space:pre; }
.agent-playground .af-message--assistant .af-message__body ul { list-style:disc; padding-left:1.5em; margin:.6em 0; }
.agent-playground .af-message--assistant .af-message__body ol { list-style:decimal; padding-left:1.5em; margin:.6em 0; }
.agent-playground .af-message--assistant .af-message__body h1,.agent-playground .af-message--assistant .af-message__body h2,.agent-playground .af-message--assistant .af-message__body h3 { font-weight:700; margin:.8em 0 .4em; }
.agent-playground .af-message--assistant .af-message__body h1 { font-size:1.35em; }
.agent-playground .af-message--assistant .af-message__body h2 { font-size:1.2em; }
.agent-playground .af-message--assistant .af-message__body h3 { font-size:1.1em; }
.agent-playground .af-message--assistant .af-message__body pre { overflow-x:auto; padding:12px; border-radius:8px; background:rgba(148,163,184,.12); margin:.65em 0; }
.agent-playground .af-message--assistant .af-message__body code { font-family:ui-monospace,SFMono-Regular,Consolas,monospace; }
.agent-playground .af-message--assistant .af-message__body :not(pre) > code { padding:2px 4px; border-radius:4px; background:rgba(148,163,184,.12); }
.agent-playground .af-message--assistant .af-message__body table { display:block; overflow-x:auto; border-collapse:collapse; margin:.65em 0; }
.agent-playground .af-message--assistant .af-message__body th,.agent-playground .af-message--assistant .af-message__body td { border:1px solid var(--line,rgba(148,163,184,.3)); padding:6px 10px; }
.agent-playground .af-message--assistant .af-message__body a { color:var(--accent,#60a5fa); text-decoration:underline; }
.agent-playground .af-message--assistant .af-message__body blockquote { border-left:3px solid var(--line,rgba(148,163,184,.4)); padding-left:12px; margin:.65em 0; }

.agent-playground .af-activity-run { padding: 14px; border-bottom: 1px solid var(--line, rgba(148,163,184,.2)); }
.agent-playground .af-activity-heading { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:16px; color:var(--text-heading,inherit); }
.agent-playground .af-activity-badge { border:1px solid rgba(148,163,184,.3); border-radius:999px; padding:3px 10px; font-size:11px; }
.agent-playground .af-activity-badge--success { color:#34d399; border-color:#047857; background:rgba(16,185,129,.09); }
.agent-playground .af-activity-badge--failed { color:#fb7185; border-color:#be123c; background:rgba(244,63,94,.09); }
.agent-playground .af-activity-timeline { list-style:none; padding:0; margin:0; }
.agent-playground .af-activity-step { position:relative; display:flex; gap:12px; padding:0 0 12px; min-width:0; }
.agent-playground .af-activity-step:not(:last-child)::before { content:""; position:absolute; left:16px; top:33px; bottom:0; width:2px; background:rgba(148,163,184,.25); }
.agent-playground .af-activity-icon { position:relative; z-index:1; flex:0 0 34px; height:34px; display:grid; place-items:center; border-radius:50%; color:#93c5fd; background:rgba(59,130,246,.2); border:1px solid rgba(96,165,250,.35); font-weight:700; }
.agent-playground .af-activity-icon--success { color:#6ee7b7; background:rgba(16,185,129,.18); border-color:#059669; }
.agent-playground .af-activity-icon--failed { color:#fda4af; background:rgba(244,63,94,.18); border-color:#e11d48; }
.agent-playground .af-activity-body { flex:1; min-width:0; border:1px solid rgba(148,163,184,.18); border-radius:11px; padding:10px 12px; background:rgba(148,163,184,.045); }
.agent-playground .af-activity-line { display:flex; justify-content:space-between; align-items:center; gap:8px; font-size:13px; }
.agent-playground .af-activity-line strong { font-weight:650; }
.agent-playground .af-activity-time { color:var(--text-muted,#94a3b8); font-size:11px; white-space:nowrap; }
.agent-playground .af-activity-body p { font-size:12px; line-height:1.5; color:var(--text-muted,#94a3b8); margin:4px 0 0; }
.agent-playground .af-activity-details { margin-top:8px; font-size:11px; color:var(--text-muted,#94a3b8); }
.agent-playground .af-activity-details summary { cursor:pointer; width:fit-content; }
.agent-playground .af-activity-details pre { overflow:auto; max-height:220px; padding:8px; margin-top:6px; border-radius:6px; background:rgba(0,0,0,.18); white-space:pre-wrap; overflow-wrap:anywhere; }
.agent-playground .af-activity-footer { display:flex; justify-content:space-between; gap:8px; border-top:1px solid rgba(148,163,184,.2); padding-top:12px; font-size:12px; color:var(--text-muted,#94a3b8); }

.agent-playground .af-trace-metrics { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; margin:0 0 14px; }
.agent-playground .af-trace-metric { display:flex; flex-direction:column; gap:2px; padding:10px; border:1px solid var(--line,rgba(148,163,184,.2)); border-radius:10px; background:rgba(148,163,184,.055); }
.agent-playground .af-trace-metric strong { color:var(--text-heading,inherit); font-size:19px; line-height:1.3; }
.agent-playground .af-trace-metric span { font-size:11px; color:var(--text-muted,#94a3b8); }
.agent-playground .af-trace-controls { display:flex; justify-content:space-between; align-items:center; gap:8px; margin-bottom:12px; }
.agent-playground .af-trace-filter,.agent-playground .af-trace-copy { border:1px solid var(--line,rgba(148,163,184,.3)); border-radius:8px; background:var(--surface,transparent); color:var(--text-heading,inherit); padding:7px 9px; font-size:12px; min-width:0; }
.agent-playground .af-trace-copy { cursor:pointer; white-space:nowrap; }
.agent-playground .af-trace-workspace { display:grid; grid-template-columns:minmax(0,1fr); gap:12px; }
.agent-playground .af-activity-step { display:block; padding:0 0 7px; }
.agent-playground .af-activity-step::before { display:none; }
.agent-playground .af-activity-step[hidden] { display:none; }
.agent-playground .af-trace-event { display:flex; align-items:flex-start; gap:8px; width:100%; text-align:left; cursor:pointer; padding:9px 8px; border:1px solid var(--line,rgba(148,163,184,.2)); border-radius:10px; background:transparent; color:inherit; }
.agent-playground .af-trace-event:hover,.agent-playground .af-trace-selected .af-trace-event { background:rgba(99,102,241,.08); border-color:rgba(99,102,241,.45); }
.agent-playground .af-trace-event:focus-visible,.agent-playground .af-trace-copy:focus-visible,.agent-playground .af-trace-filter:focus-visible { outline:2px solid var(--accent,#6366f1); outline-offset:2px; }
.agent-playground .af-trace-event .af-activity-icon { flex-basis:26px; height:26px; font-size:12px; }
.agent-playground .af-trace-event-content { display:flex; flex-direction:column; gap:4px; flex:1; min-width:0; }
.agent-playground .af-trace-event-content strong { font-size:12px; overflow-wrap:anywhere; }
.agent-playground .af-trace-event-content small { font-size:11px; line-height:1.4; color:var(--text-muted,#94a3b8); overflow-wrap:anywhere; }
.agent-playground .af-trace-inspector { min-width:0; border:1px solid var(--line,rgba(148,163,184,.2)); border-radius:11px; padding:12px; background:rgba(148,163,184,.035); }
.agent-playground .af-trace-inspector-heading { display:flex; justify-content:space-between; align-items:flex-start; gap:8px; }
.agent-playground .af-trace-inspector-heading strong { font-size:13px; overflow-wrap:anywhere; min-width:0; }
.agent-playground .af-trace-inspector > p { font-size:12px; line-height:1.5; margin:10px 0; color:var(--text-muted,#94a3b8); }
.agent-playground .af-trace-metadata { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.5fr); gap:7px; font-size:11px; margin:12px 0; }
.agent-playground .af-trace-metadata dt { color:var(--text-muted,#94a3b8); }
.agent-playground .af-trace-metadata dd { margin:0; overflow-wrap:anywhere; font-family:ui-monospace,SFMono-Regular,Consolas,monospace; }
.agent-playground .af-activity-details pre { max-height:320px; white-space:pre-wrap; }
@@media (min-width:1536px) { .agent-playground .af-trace-workspace { grid-template-columns:minmax(0,1fr) minmax(0,1fr); } }
</style>
<section class="ui-panel agent-playground" style="margin-top: 16px;" aria-labelledby="agentPlaygroundHeading" data-agent-id="@Model.Id">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h2 id="agentPlaygroundHeading"><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m8 5 7 7-7 7"/><path d="M16 19h5"/></svg></span> Playground</h2>
            <p class="ui-subtitle">Test your agent with its assigned tools and inspect each execution.</p>
        </div>
        <button type="button" class="ui-button ui-button--secondary" data-playground-reset>New session</button>
    </div>
    <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-muted">
        <span class="ui-tool-card-badge">@Model.Name</span>
        <span class="ui-tool-card-badge">@assignedToolCount assigned tools</span>
        <span class="ui-tool-card-badge">Execution tracing</span>
    </div>
    <div class="mt-4 grid grid-cols-1 items-stretch gap-4 xl:grid-cols-3" style="height: 100vh; min-height: 0;" data-playground-layout>
        <div class="xl:col-span-2 flex min-h-0 min-w-0 flex-col overflow-hidden rounded-xl border border-line bg-surface">
            <div class="flex items-start gap-2 border-b border-line px-4 py-2">
                <span class="ui-panel-icon shrink-0" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/></svg></span>
                <div class="min-w-0">
                    <h3 class="m-0 text-sm font-semibold text-heading">Agent conversation</h3>
                    <p class="m-0 text-xs leading-snug text-muted">Chat with your agent and review its responses here.</p>
                </div>
            </div>
            <div class="flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto p-4" data-playground-messages role="log" aria-live="polite" aria-label="Playground conversation">
                <div class="m-auto max-w-md text-center" data-playground-welcome>
                    <div class="mb-3 text-2xl" aria-hidden="true">✦</div>
                    <h3 class="font-semibold text-heading">Start a conversation</h3>
                    <p class="mt-2 text-sm text-muted">Send a message to test your agent and inspect its execution trace.</p>
                </div>
            </div>
            <form class="shrink-0 border-t border-line p-3" data-playground-form>
                <label for="agentPlaygroundMessage" class="sr-only">Message your agent</label>
                <div class="flex items-end gap-2">
                    <textarea id="agentPlaygroundMessage" rows="2" maxlength="8000" class="min-w-0 flex-1 resize-y rounded-xl border border-line bg-surface px-3 py-2 text-sm text-content" placeholder="Ask your agent anything..." data-playground-input></textarea>
                    <button type="submit" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-[10px] border-0 bg-accent text-xl font-bold text-white " style="width:35px;height:35px;border-radius:10px;background:var(--accent);color:var(--button-text);cursor:pointer;" data-playground-send aria-label="Send message" title="Send message">↑</button>
                </div>
            </form>
        </div>
        <aside class="flex min-h-0 min-w-0 flex-col overflow-hidden rounded-xl border border-line bg-surface" aria-labelledby="playgroundTraceHeading">
            <div class="flex items-start gap-2 border-b border-line px-4 py-2">
                <span class="ui-panel-icon shrink-0" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h6v6H4zM14 5h6v6h-6zM9 11v4h8M17 15v4M14 19h6"/></svg></span>
                <div class="min-w-0">
                    <h3 id="playgroundTraceHeading" class="m-0 text-sm font-semibold text-heading">Execution trace</h3>
                    <p class="m-0 text-xs leading-snug text-muted">Inspect AI calls, tool executions, and errors.</p>
                </div>
            </div>
            <div class="af-inspector-summary" data-playground-summary hidden></div>
            <div class="af-inspector-scroll min-h-0 flex-1 overflow-y-auto">
                <div class="rounded-xl border border-dashed border-line p-5 text-center text-sm text-muted" data-playground-trace-empty>
                    No execution yet.
                </div>
                <div data-playground-trace hidden></div>
            </div>
        </aside>
    </div>
</section>
