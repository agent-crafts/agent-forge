@model IReadOnlyList<AgentForge.Web.Controllers.AgentsController.AgentCard>
@{
    Layout = "_AppLayout";
    var categories = (IReadOnlyList<string>)(ViewData["Categories"] ?? Array.Empty<string>());
    var pageNumber = (int)(ViewData["PageNumber"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 0);
    var categoryOptions = new[] { new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Text = "All Categories", Value = "all" } }.Concat(categories.Select(category => new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Text = category, Value = category.ToLowerInvariant() })).ToList();
}
<div class="ui-toolbar mb-6 flex flex-wrap items-center gap-3">
    <label class="ui-visually-hidden" for="agentSearch">Search agents</label>
    <div class="min-w-0 flex-1"><ui-input id="agentSearch" type="search" auto-complete="off" placeholder="Search agents..." /></div>
    <label class="ui-visually-hidden" for="agentCategory">Filter agents by category</label>
    <div class="ui-select-wrap relative h-11 shrink-0">
        <ui-select id="agentCategory" options="categoryOptions" />
        <svg class="ui-select-chevron pointer-events-none absolute right-3 size-4 text-muted" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
    </div>
    <ui-button id="openAgentDialog" variant="secondary" text="+ Add Agent" aria-label="Add Agent" aria-has-popup="dialog" aria-controls="createAgentDialog" />
</div>

<div id="agentGrid" class="ui-grid grid grid-cols-1 gap-3 lg:grid-cols-2">
    @foreach (var agent in Model)
    {
        <a href="/agents/@Uri.EscapeDataString(agent.Id)" aria-label="View details for @agent.Name" class="agent-card ui-item-card group flex min-w-0 items-start cursor-default gap-3 rounded-xl border border-line bg-surface px-3 py-3 text-content transition-all duration-150 hover:-translate-y-0.5 hover:border-line-strong hover:bg-hover hover:shadow-sm"
                 data-search="@($"{agent.Name} {agent.Description} {string.Join(" ", agent.Tags)}".ToLowerInvariant())"
                 data-category="@agent.Category.ToLowerInvariant()">
            <span aria-hidden="true" class="ui-icon-tile self-start text-xl font-semibold">@if (agent.Icon.StartsWith("/uploads/agent-icons/", StringComparison.Ordinal)) { <img src="@agent.Icon" alt="" width="40" height="40" class="h-10 w-10 rounded-lg object-cover" /> } else { <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="40" height="40"><path d="M12 3v3M4 12H2m20 0h-2M6 20h12a3 3 0 0 0 3-3v-6a5 5 0 0 0-5-5H8a5 5 0 0 0-5 5v6a3 3 0 0 0 3 3ZM8 13h.01M16 13h.01" /></svg> }</span>
            <div class="ui-item-content flex min-w-0 flex-1 flex-col gap-0.5">
                <span class="ui-item-title break-words text-sm font-semibold text-heading">@agent.Name</span>
                <span class="ui-item-description break-words text-xs leading-5 text-muted">@agent.Description</span>
                <div class="ui-tool-card-badges" aria-label="Agent category and capabilities">
                    <span class="ui-tool-card-badge"><span class="ui-tool-card-badge-label">Category</span> @agent.Category</span>
                    @if (agent.Tags.Length > 0)
                    {
                        <span class="ui-tool-card-badge"><span class="ui-tool-card-badge-label">Capability</span> @agent.Tags[0]</span>
                    }
                </div>
            </div>
        </a>
    }
</div>
@if (totalPages > 1)
{
    <nav class="mt-5 flex items-center justify-between gap-3" aria-label="Agents pages">
        <span class="text-sm text-muted">Page @pageNumber of @totalPages</span>
        <div class="flex gap-2">
            @if (pageNumber > 1) { <a class="ui-button" href="/agents?pageNumber=@(pageNumber - 1)">Previous</a> }
            @if (pageNumber < totalPages) { <a class="ui-button" href="/agents?pageNumber=@(pageNumber + 1)">Next</a> }
        </div>
    </nav>
}
<p id="agentEmpty" class="mt-5 rounded-xl border border-dashed border-line p-6 text-sm text-muted" hidden>No agents found on this page.</p>
<partial name="_CreateAgentDialog" />
<script src="~/js/agents/agent-create.js" asp-append-version="true"></script>
<script src="~/js/agents/agents-gallery.js" asp-append-version="true"></script>
