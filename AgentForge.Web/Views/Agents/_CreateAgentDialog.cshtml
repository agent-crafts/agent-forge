@using Microsoft.AspNetCore.Mvc.Rendering
@{
  var categories = new[] { "Select category", "Development", "Planning", "Quality", "Testing", "Operations", "Documentation", "Research", "Data", "Other" }.Select((value, i) => new SelectListItem { Text = value, Value = i == 0 ? "" : value }).ToList();
  var icons = new[] { ("◈ Default", "◈"), ("◇ Review", "◇"), ("⚙ Operations", "⚙"), ("▤ Documentation", "▤") }.Select(value => new SelectListItem { Text = value.Item1, Value = value.Item2 }).ToList();
}
<ui-modal id="createAgentDialog" css-class="agent-dialog" width="1080" variant="wizard" title="Create New Agent" description="Define your agent identity and core behavior. Configure tools, skills, and other settings later." title-id="createAgentTitle" description-id="createAgentDescription" close-button-id="closeAgentDialog" cancel-button-id="cancelAgentDialog" previous-button-id="previousAgentStep" next-button-id="nextAgentStep" submit-button-id="submitAgentForm">
  <form id="agentCreateForm" class="agent-dialog-form">
    @Html.AntiForgeryToken()
    <nav class="agent-dialog-steps" aria-label="Creation steps">
      <span class="agent-dialog-step is-active" data-step-indicator="0"><b>1</b> Basic Information</span>
      <span class="agent-dialog-step" data-step-indicator="1"><b>2</b> Instructions</span>
    </nav>
    <div class="agent-dialog-body">
      <section data-agent-step="0" aria-label="Basic Information">
        <div class="agent-form-grid">
          <div class="agent-field"><ui-field id="agentName" name="name" label="Agent Name" required="true" max-length="80" placeholder="e.g. Code Review Agent" hint="A clear and descriptive name for your agent." /></div>
          <div class="agent-field"><ui-field id="agentCategoryInput" name="category" label="Category" control="select" required="true" options="@categories" hint="Choose the primary category." /></div>
          <div class="agent-field agent-field-wide"><ui-field id="agentDescription" name="description" label="Description" control="textarea" rows="4" max-length="300" required="true" placeholder="What does this agent do?" hint="Briefly describe what this agent does and when to use it." /></div>
          <div class="agent-field"><ui-field id="agentIcon" name="icon" label="Icon" control="select" options="@icons" hint="Choose an icon to represent your agent." /></div>
          <div class="agent-field"><ui-field id="agentTags" name="tags" label="Tags" max-length="200" placeholder="e.g. code, review, quality" hint="Separate tags with commas." /></div>
        </div>
      </section>
      <section data-agent-step="1" aria-label="Instructions" hidden>
        <div class="agent-field"><ui-field id="agentInstructions" name="instructions" label="System Instructions" control="textarea" rows="11" max-length="12000" required="true" placeholder="You are an AI agent responsible for..." hint="Describe the role, responsibilities, rules, and expected output. Do not include credentials." /></div>
      </section>
    </div>
    <p class="agent-dialog-feedback" id="agentFormFeedback" role="status" hidden></p>
  </form>
</ui-modal>
