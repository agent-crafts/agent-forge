@using AgentForge.Core.Domains
@model AgentForge.Web.Controllers.AgentsController.AgentCard
@{
    var tools = ViewData["AvailableAgentTools"] as Tool[] ?? [];
    var assigned = ViewData["AssignedAgentToolIds"] as HashSet<Guid> ?? [];
    var categories = tools.Select(t => t.Category.ToString()).Distinct().OrderBy(x => x).ToArray();
}
<section class="ui-panel agent-tools" aria-labelledby="agentToolsHeading" data-agent-id="@Model.Id">
    <div class="agent-tools-heading">
        <h2 id="agentToolsHeading">Tools</h2>
        <div class="agent-tools-controls">
            <label class="agent-tools-search"><span class="sr-only">Search tools</span><input type="search" placeholder="Search tools..." data-agent-tool-search /></label>
            <select data-agent-tool-category aria-label="Filter tools by category">
                <option value="">All categories</option>
                @foreach (var category in categories) { <option value="@category">@category</option> }
            </select>
        </div>
    </div>
    <p class="ui-subtitle">Choose which registered tools this agent may use. Changes take effect when saved.</p>
    <div class="agent-tools-list ui-grid grid grid-cols-1 gap-3 lg:grid-cols-2">
        @foreach (var tool in tools)
        {
            <article class="agent-tool-row ui-item-card flex min-w-0 items-start gap-3 rounded-xl border border-line bg-surface px-3 py-3" data-agent-tool-row data-category="@tool.Category" data-search="@($"{tool.Name} {tool.DisplayName} {tool.Description} {tool.Category}".ToLowerInvariant())">
                <div class="ui-item-content flex min-w-0 flex-1 flex-col gap-0.5">
                    <h3 class="ui-item-title break-words text-sm font-semibold text-heading">@tool.DisplayName</h3>
                    <p class="ui-item-description break-words text-xs leading-5 text-muted">@tool.Description</p>
                    <span class="ui-tool-card-badge">@tool.Category</span>
                </div>
                <label class="agent-tool-toggle">
                    <input type="checkbox" value="@tool.Id" data-agent-tool-toggle checked="@assigned.Contains(tool.Id)" aria-label="Enable @tool.DisplayName" />
                    <span aria-hidden="true"></span>
                </label>
            </article>
        }
        <p class="agent-tools-empty" data-agent-tool-empty hidden>No tools match your search or category.</p>
    </div>
    <div class="agent-instructions-actions">
        <button type="button" class="ui-button ui-button--primary" data-agent-tools-save>Save Changes</button>
    </div>
</section>
