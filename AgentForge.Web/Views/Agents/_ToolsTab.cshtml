@model AgentForge.Web.Controllers.AgentsController.AgentCard
@{
    var tools = new[]
    {
        new { Name = "GitHub", Description = "Repository access, code search, issues, and pull requests.", Category = "Development", Icon = "github" },
        new { Name = "Terminal", Description = "Run commands and tests in a development environment.", Category = "Development", Icon = "terminal" },
        new { Name = "File System", Description = "Read and write files in the project workspace.", Category = "File Management", Icon = "folder" },
        new { Name = "Web Search", Description = "Find technical documentation and research resources.", Category = "Search", Icon = "globe" },
        new { Name = "Documentation", Description = "Access project documentation and reference material.", Category = "Knowledge", Icon = "book" },
        new { Name = "Code Analysis", Description = "Analyze code quality, security, and performance.", Category = "Analysis", Icon = "chart" },
        new { Name = "Docker", Description = "Build and manage containerized applications.", Category = "Development", Icon = "box" }
    };
}
<section class="ui-panel agent-tools" aria-labelledby="agentToolsHeading">
    <div class="agent-tools-heading">
        <h2 id="agentToolsHeading"><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a5 5 0 0 0-6.4 6.4L3 18a2.1 2.1 0 0 0 3 3l5.3-5.3a5 5 0 0 0 6.4-6.4l-3 3-3-3 3-3Z"/></svg></span> Tools</h2>
        <div class="agent-tools-controls">
            <label class="agent-tools-search"><span class="sr-only">Search tools</span><input type="search" placeholder="Search tools..." data-agent-tool-search /></label>
            <label class="sr-only" for="agentToolCategory">Tool category</label>
            <select id="agentToolCategory" data-agent-tool-category aria-label="Filter tools by category"><option value="">All categories</option><option>Development</option><option>File Management</option><option>Search</option><option>Knowledge</option><option>Analysis</option></select>
        </div>
    </div>
    <p class="ui-subtitle">Choose which tools this agent may use. These are sample tools; selections are not saved or connected to a runtime.</p>
    <div class="agent-tools-list ui-grid grid grid-cols-1 gap-3 lg:grid-cols-2">
        @foreach (var tool in tools)
        {
            <article class="agent-tool-row ui-item-card group flex min-w-0 items-start gap-3 rounded-xl border border-line bg-surface px-3 py-3 text-content transition-all duration-150 hover:-translate-y-0.5 hover:border-line-strong hover:bg-hover hover:shadow-sm" data-agent-tool-row data-category="@tool.Category" data-search="@($"{tool.Name} {tool.Description} {tool.Category}".ToLowerInvariant())">
                <span class="agent-tool-symbol ui-icon-tile self-start" aria-hidden="true">
                    @switch (tool.Icon)
                    {
                        case "github": <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.76-.24.76-.54v-2.1c-3.1.68-3.76-1.32-3.76-1.32-.5-1.3-1.24-1.65-1.24-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 .1.68 2.06 3.23 1.45.1-.72.4-1.21.73-1.5-2.48-.28-5.1-1.24-5.1-5.54 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.1-2.96 0 0 .94-.3 3.08 1.15a10.7 10.7 0 0 1 5.6 0c2.14-1.45 3.08-1.15 3.08-1.15.6 1.54.22 2.68.1 2.96.72.78 1.15 1.78 1.15 3 0 4.3-2.62 5.25-5.12 5.53.42.37.8 1.08.8 2.18v3.24c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8Z"/></svg> break;
                        case "terminal": <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m4 6 6 6-6 6M12 18h8"/></svg> break;
                        case "folder": <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M3 6h7l2 3h9v11H3z"/></svg> break;
                        case "globe": <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c-6 6-6 12 0 18M12 3c6 6 6 12 0 18"/></svg> break;
                        case "book": <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 6C9 4 6 4 3 5v14c3-1 6-1 9 1 3-2 6-2 9-1V5c-3-1-6-1-9 1ZM12 6v14"/></svg> break;
                        case "chart": <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 20V12M12 20V4M19 20V9"/></svg> break;
                        default: <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M4 10h16"/></svg> break;
                    }
                </span>
                <div class="agent-tool-description ui-item-content flex min-w-0 flex-1 flex-col gap-0.5"><h3 class="ui-item-title break-words text-sm font-semibold text-heading">@tool.Name</h3><p class="ui-item-description break-words text-xs leading-5 text-muted">@tool.Description</p><span class="ui-tool-card-badges" aria-label="Tool category"><span class="ui-tool-card-badge"><span class="ui-tool-card-badge-label">Category</span> @tool.Category</span></span></div>
                <label class="agent-tool-toggle"><input type="checkbox" aria-label="Enable @tool.Name (local preview only)" checked="@(tool.Name != "Docker")" /><span aria-hidden="true"></span></label>
            </article>
        }
        <p class="agent-tools-empty" data-agent-tool-empty hidden>No tools match your search or category.</p>
    </div>
</section>
<script>
(() => {
    const panel = document.querySelector('#agentToolsPanel');
    if (!panel) return;
    const search = panel.querySelector('[data-agent-tool-search]');
    const select = panel.querySelector('[data-agent-tool-category]');
    const rows = [...panel.querySelectorAll('[data-agent-tool-row]')];
    const empty = panel.querySelector('[data-agent-tool-empty]');
    function filter() {
        const query = search.value.trim().toLowerCase();
        const category = select.value;
        let count = 0;
        rows.forEach(row => {
            const visible = (!category || row.dataset.category === category) && row.dataset.search.includes(query);
            row.hidden = !visible;
            if (visible) count++;
        });
        empty.hidden = count !== 0;
    }
    search.addEventListener('input', filter);
    select.addEventListener('change', filter);
})();
</script>
