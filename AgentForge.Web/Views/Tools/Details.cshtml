@model AgentForge.Web.Controllers.ToolsController.ToolCatalogItem
@using System.Text.Json
@{
    Layout = "_AppLayout";
    using var schemaDocument = JsonDocument.Parse(Model.JsonSchema);
    var schema = schemaDocument.RootElement;
    var hasProperties = schema.TryGetProperty("properties", out var properties) && properties.ValueKind == JsonValueKind.Object;
    var required = new HashSet<string>(StringComparer.Ordinal);
    if (schema.TryGetProperty("required", out var requiredElement) && requiredElement.ValueKind == JsonValueKind.Array)
    {
        foreach (var item in requiredElement.EnumerateArray())
        {
            if (item.ValueKind == JsonValueKind.String && item.GetString() is { } name) required.Add(name);
        }
    }
    var isGitHub = Model.Icon == "github";
    using var githubConfiguration = JsonDocument.Parse(Model.ConfigurationJson);
    var githubOwner = githubConfiguration.RootElement.TryGetProperty("owner", out var githubOwnerValue) ? githubOwnerValue.GetString() : null;
    var githubRepo = githubConfiguration.RootElement.TryGetProperty("repo", out var githubRepoValue) ? githubRepoValue.GetString() : null;
    var example = new Dictionary<string, object?>();
    if (hasProperties)
    {
        foreach (var property in properties.EnumerateObject())
        {
            var value = property.Value;
            var type = value.ValueKind == JsonValueKind.Object && value.TryGetProperty("type", out var typeElement)
                && typeElement.ValueKind == JsonValueKind.String ? typeElement.GetString() : null;
            example[property.Name] = type switch
            {
                "integer" => value.TryGetProperty("minimum", out var minimum) && minimum.TryGetInt32(out var min) ? Math.Max(1, min) : 1,
                "number" => 1,
                "boolean" => true,
                "array" => Array.Empty<string>(),
                "object" => new Dictionary<string, object>(),
                _ => property.Name.Equals("owner", StringComparison.OrdinalIgnoreCase) ? "octocat"
                    : property.Name.Equals("repo", StringComparison.OrdinalIgnoreCase) ? "hello-world" : "example"
            };
        }
    }
    var exampleJson = JsonSerializer.Serialize(example, new JsonSerializerOptions { WriteIndented = true });
    var formattedSchema = JsonSerializer.Serialize(schema, new JsonSerializerOptions { WriteIndented = true });
}
<div class="ui-detail">

    <section class="ui-profile ui-tool-profile">
    <div class="ui-tool-actions" role="group" aria-label="Tool actions">
        <button type="button" id="openEditToolDialog" class="ui-button ui-tool-action ui-tool-action--edit" aria-label="Edit tool" title="Edit tool"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L9 17l-4 1 1-4Z"/></svg></button>
        <button type="button" id="deleteToolButton" class="ui-button ui-tool-action ui-tool-action--delete" aria-label="Delete tool" title="Delete tool"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M5 6l1 14h12l1-14M10 10v7M14 10v7"/></svg></button>
    </div>
        <div class="ui-profile-icon" aria-hidden="true">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@(Model.ImageUrl?.StartsWith("tools/") == true ? "/api/files/" + Model.ImageUrl : Model.ImageUrl)" alt="" class="h-full w-full object-contain" />
                }
                else
                {
                    <partial name="_ToolIcon" model="Model.Icon" />
                }
        </div>
        <div class="ui-profile-main flex flex-col items-start gap-4">
            <div class="ui-profile-title"><h1>@Model.DisplayName</h1></div>
            <div class="ui-tags"><span>@Model.Name</span></div>
        </div>

    </section>
    <div class="mt-6 flex gap-2 border-b border-line" role="tablist" aria-label="Tool details sections">
        <partial name="_Button" model='new UiButtonModel { Text = "Overview", Variant = UiButtonVariant.Ghost, Id = "toolOverviewTab", Role = "tab", AriaControls = "toolOverviewPanel", AriaSelected = "true", CssClass = "border-b-2 border-accent px-5 py-3 text-heading" }' />
        <partial name="_Button" model='new UiButtonModel { Text = "Try Now", Variant = UiButtonVariant.Ghost, Id = "toolTryTab", Role = "tab", AriaControls = "toolTryPanel", AriaSelected = "false", TabIndex = -1, CssClass = "border-b-2 border-transparent px-5 py-3 text-muted" }' />
    </div>
    <div id="toolOverviewPanel" role="tabpanel" aria-labelledby="toolOverviewTab">
    <div class="ui-columns">
        <div class="ui-stack">
            <section class="ui-panel" id="tool-overview">
                <div class="ui-panel-title-block"><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z"/><path d="M12 11v5M12 8h.01"/></svg></span><div class="ui-panel-title-copy"><h2>Overview</h2><p class="ui-subtitle">What this tool does and when to use it.</p></div></div>
                <div class="ui-markdown-content" data-markdown-render>@Model.Description</div>
                <div class="ui-note"><strong>When to use this tool</strong><p>Use this tool when its registered capability matches your task. Review the input contract before integrating it into an agent workflow.</p></div>
            </section>
            <section class="ui-panel" id="tool-parameters">
                <div class="ui-panel-title-block"><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 17h16"/><circle cx="9" cy="7" r="2" fill="var(--surface-raised)"/><circle cx="15" cy="17" r="2" fill="var(--surface-raised)"/></svg></span><div class="ui-panel-title-copy"><h2>Parameters</h2><p class="ui-subtitle">Required inputs and types from the registered schema.</p></div></div>
                @if (hasProperties)
                {
                    <div class="ui-table-scroll"><table class="ui-table">
                        <thead><tr><th>Parameter</th><th>Type</th><th>Required</th></tr></thead>
                        <tbody>
                        @foreach (var property in properties.EnumerateObject())
                        {
                            var parameter = property.Value;
                            var type = parameter.ValueKind == JsonValueKind.Object && parameter.TryGetProperty("type", out var parameterType)
                                ? parameterType.ToString() : "any";
                            <tr><td><code>@property.Name</code></td><td>@type</td><td>@if (required.Contains(property.Name)) { <span class="ui-required">Yes</span> } else { <span>No</span> }</td></tr>
                        }
                        </tbody>
                    </table></div>
                }
                else { <p>No individual input parameters are declared in the schema.</p> }
            </section>
        </div>
        <div class="ui-stack">
            <section class="ui-panel" id="tool-schema">
                <div class="ui-panel-heading"><div class="ui-panel-title-block"><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4C5 4 5 6 5 8v1c0 2-1 3-3 3 2 0 3 1 3 3v1c0 2 0 4 3 4M16 4c3 0 3 2 3 4v1c0 2 1 3 3 3-2 0-3 1-3 3v1c0 2 0 4-3 4"/></svg></span><div class="ui-panel-title-copy"><h2>JSON Schema</h2><p class="ui-subtitle">The registered input contract for this tool.</p></div></div><partial name="_Button" model='new UiButtonModel { Text = "Copy", Variant = UiButtonVariant.Outlined, CssClass = "ui-copy", CopyTarget = "tool-schema-code" }' /></div>
                <partial name="_JsonViewer" model='("tool-schema-code", (string?)formattedSchema)' />
            </section>
            <section class="ui-panel" id="tool-example">
                <div class="ui-panel-heading"><div class="ui-panel-title-block"><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="19" height="16" rx="2"/><path d="m7 9 3 3-3 3M12 15h5"/></svg></span><div class="ui-panel-title-copy"><h2>Example Input</h2><p class="ui-subtitle">Illustrative values based on the schema; not executed.</p></div></div><partial name="_Button" model='new UiButtonModel { Text = "Copy", Variant = UiButtonVariant.Outlined, CssClass = "ui-copy", CopyTarget = "tool-example-code" }' /></div>
                <partial name="_JsonViewer" model='("tool-example-code", (string?)exampleJson)' />
            </section>
            <p class="ui-footnote">Open Try Now to see whether this tool can run from the catalog.</p>
        </div>
    </div>
    </div>
    <section id="toolTryPanel" role="tabpanel" aria-labelledby="toolTryTab" hidden>
        @if (Model.ExecutorKey == "get_github_issue" || Model.Name == "get_github_issue" || Model.ExecutorKey == "http.get_json" || (Model.Kind == "external" && Model.ExecutorKey == "mcp"))
        {
            <div class="ui-columns">
                <div class="ui-stack"><section class="ui-panel min-w-0">
                    <div class="ui-panel-title-block"><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m8 5 11 7-11 7V5Z"/></svg></span><div class="ui-panel-title-copy"><h2>Try this tool</h2>
                    <p class="ui-subtitle">Enter JSON arguments to execute this tool.</p></div></div>
                    <form id="toolTryForm" method="post" action="/api/tools/@Model.Id/execute" class="grid gap-4">
                        @Html.AntiForgeryToken()
                        <div class="ui-field">
                            <label class="ui-field-label" for="toolArguments">Arguments (JSON)</label>
                            <p id="toolArgumentsHint" class="ui-field-hint">Replace the example values with your inputs. Use {} for a tool without arguments.</p>
                            <textarea id="toolArguments" class="ui-textarea" rows="8" spellcheck="false" aria-describedby="toolArgumentsHint toolArgumentsError">@exampleJson</textarea>
                            <p id="toolArgumentsError" class="ui-field-error" role="alert" hidden></p>
                        </div>
                        <button id="toolRun" class="ui-button ui-button--primary" type="submit">Run Tool</button>
                    </form>
                </section></div>
                <div class="ui-stack"><section class="ui-panel min-w-0">
                    <div class="ui-panel-title-block"><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4C5 4 5 6 5 8v1c0 2-1 3-3 3 2 0 3 1 3 3v1c0 2 0 4 3 4M16 4c3 0 3 2 3 4v1c0 2 1 3 3 3-2 0-3 1-3 3v1c0 2 0 4-3 4"/></svg></span><div class="ui-panel-title-copy"><h2>Response</h2>
                    <p class="ui-subtitle">Inspect the response returned by the tool.</p></div></div>
                    <p id="toolStatus" class="ui-subtitle" role="status">Not run</p>
                    <partial name="_JsonViewer" model='("toolResult", (string?)null)' />
                </section></div>
            </div>
        }
        else
        {
            <div class="ui-columns"><div class="ui-stack"><section class="ui-panel"><div class="ui-panel-title-block"><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m8 5 11 7-11 7V5Z"/></svg></span><div class="ui-panel-title-copy"><h2>Try Now</h2><p class="ui-subtitle">This tool does not have an approved UI execution adapter yet.</p></div></div><partial name="_Button" model='new UiButtonModel { Text = "Run Tool", Variant = UiButtonVariant.Primary, Disabled = true, CssClass = "mt-5" }' /></section></div></div>
        }
    </section>
</div>

<script>
document.querySelectorAll('.ui-detail [data-copy-target]').forEach(button => {
    button.addEventListener('click', async () => {
        const code = document.getElementById(button.dataset.copyTarget);
        if (!code || !navigator.clipboard) return;
        try {
            await navigator.clipboard.writeText(code.textContent || '');
            button.textContent = 'Copied';
            button.setAttribute('aria-label', 'Copied to clipboard');
        } catch {
            button.textContent = 'Copy failed';
        }
    });
});
</script>

<script>
(() => {
    const tabs = [document.getElementById('toolOverviewTab'), document.getElementById('toolTryTab')];
    const panels = [document.getElementById('toolOverviewPanel'), document.getElementById('toolTryPanel')];
    tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
            tabs.forEach((item, i) => {
                const active = i === index;
                item.setAttribute('aria-selected', String(active));
                item.tabIndex = active ? 0 : -1;
                item.classList.toggle('border-accent', active);
                item.classList.toggle('border-transparent', !active);
                item.classList.toggle('text-heading', active);
                item.classList.toggle('text-muted', !active);
                panels[i].hidden = !active;
            });
        });
        tab.addEventListener('keydown', event => {
            if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
            event.preventDefault();
            const next = (index + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length;
            tabs[next].focus();
            tabs[next].click();
        });
    });
})();
</script>

<script src="~/js/shared/json-viewer.js" asp-append-version="true"></script>
<script src="~/js/tools/tool-try.js" asp-append-version="true"></script>

<div id="toolEditContext" hidden data-tool-id="@Model.Id" data-tool-name="@Model.Name" data-tool-display-name="@Model.DisplayName" data-tool-description="@Model.Description" data-tool-category="@((int)Enum.Parse<AgentForge.Core.Enums.ToolCategory>(Model.Category, ignoreCase: true))" data-tool-kind="@Model.Kind" data-tool-image-url="@Model.ImageUrl" data-tool-schema="@Model.JsonSchema" data-tool-executor-key="@Model.ExecutorKey" data-tool-configuration="@Model.ConfigurationJson"></div>
<partial name="~/Views/Tools/_AddToolDialog.cshtml" />
<ui-delete id="deleteToolDialog" title="Delete tool?" description="The tool will be removed from the catalog" item-name="@Model.DisplayName" confirm-button-id="confirmDeleteTool" confirm-text="Delete tool" />
<script src="~/js/tools/add-tool-dialog.js" asp-append-version="true"></script>

<script src="~/js/tools/delete-tool.js" asp-append-version="true"></script>
