@model AgentForge.Web.Controllers.ToolsController.ToolCatalogItem
@using System.Text.Json
@{
    Layout = "_AppLayout";
    using var schemaDocument = JsonDocument.Parse(Model.JsonSchema);
    var schema = schemaDocument.RootElement;
    var hasProperties = schema.TryGetProperty("properties", out var properties) && properties.ValueKind == JsonValueKind.Object;
    var required = new HashSet<string>(StringComparer.Ordinal);
    if (schema.TryGetProperty("required", out var requiredElement) && requiredElement.ValueKind == JsonValueKind.Array)
    {
        foreach (var item in requiredElement.EnumerateArray())
        {
            if (item.ValueKind == JsonValueKind.String && item.GetString() is { } name) required.Add(name);
        }
    }
    var isGitHub = Model.Icon == "github";
    var source = Model.Category == "github" ? "GitHub" : "Registered tool";
    var example = new Dictionary<string, object?>();
    if (hasProperties)
    {
        foreach (var property in properties.EnumerateObject())
        {
            var value = property.Value;
            var type = value.TryGetProperty("type", out var typeElement) ? typeElement.GetString() : "string";
            example[property.Name] = type switch
            {
                "integer" => value.TryGetProperty("minimum", out var minimum) && minimum.TryGetInt32(out var min) ? Math.Max(1, min) : 1,
                "number" => 1,
                "boolean" => true,
                "array" => Array.Empty<string>(),
                "object" => new Dictionary<string, object>(),
                _ => property.Name.Equals("owner", StringComparison.OrdinalIgnoreCase) ? "octocat"
                    : property.Name.Equals("repo", StringComparison.OrdinalIgnoreCase) ? "hello-world" : "example"
            };
        }
    }
    var exampleJson = JsonSerializer.Serialize(example, new JsonSerializerOptions { WriteIndented = true });
    var formattedSchema = JsonSerializer.Serialize(schema, new JsonSerializerOptions { WriteIndented = true });
}
<link rel="stylesheet" href="~/css/tools.css" asp-append-version="true" />
<div class="tool-details-page">
    <section class="tool-profile">
        <div class="tool-profile-icon" aria-hidden="true">
            @if (isGitHub)
            {
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.54v-2.1c-3.1.67-3.75-1.32-3.75-1.32-.5-1.28-1.24-1.62-1.24-1.62-1.01-.7.08-.69.08-.69 1.12.08 1.71 1.15 1.71 1.15 1 .1.77 1.5 3.2 1.05.1-.73.39-1.22.71-1.5-2.48-.28-5.09-1.24-5.09-5.49 0-1.21.43-2.2 1.14-2.97-.12-.28-.5-1.41.11-2.94 0 0 .93-.3 3.05 1.13a10.6 10.6 0 0 1 5.55 0c2.12-1.43 3.05-1.13 3.05-1.13.61 1.53.23 2.66.11 2.94.71.77 1.14 1.76 1.14 2.97 0 4.26-2.62 5.2-5.11 5.48.4.35.76 1.02.76 2.06v3.05c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg>
            }
            else { <span>⚒</span> }
        </div>
        <div class="tool-profile-main">
            <div class="tool-profile-title"><h1>@Model.DisplayName</h1><span class="tool-registered">Registered</span></div>
            <p>@Model.Description</p>
            <div class="tool-tags"><span>@Model.Name</span><span>@source</span><span>API Tool</span><span>Read-only catalog</span></div>
        </div>
        <div class="tool-profile-meta">
            <div><small>TYPE</small><strong>API Tool</strong></div>
            <div><small>SOURCE</small><strong>@source</strong></div>
            <div><small>REGISTRY</small><strong>Available</strong></div>
            <div><small>EXECUTION</small><strong>Not enabled</strong></div>
        </div>
    </section>
    <div class="tool-details-columns">
        <div class="tool-details-stack">
            <section class="tool-panel" id="tool-overview">
                <h2><span class="tool-panel-symbol" aria-hidden="true">▤</span> Overview</h2>
                <p class="tool-section-description">What this tool does and when to use it.</p>
                <p>@Model.Description</p>
                <div class="tool-info-note"><strong>When to use this tool</strong><p>Use this tool when its registered capability matches your task. Review the input contract before integrating it into an agent workflow.</p></div>
            </section>
            <section class="tool-panel" id="tool-parameters">
                <h2><span class="tool-panel-symbol" aria-hidden="true">⚙</span> Parameters</h2>
                <p class="tool-section-description">Required inputs, types, and descriptions from the registered schema.</p>
                @if (hasProperties)
                {
                    <div class="tool-parameter-scroll"><table class="tool-parameters-table">
                        <thead><tr><th>Parameter</th><th>Type</th><th>Required</th><th>Description</th></tr></thead>
                        <tbody>
                        @foreach (var property in properties.EnumerateObject())
                        {
                            var parameter = property.Value;
                            var type = parameter.TryGetProperty("type", out var parameterType) ? parameterType.ToString() : "any";
                            var description = parameter.TryGetProperty("description", out var parameterDescription) ? parameterDescription.GetString() : "—";
                            <tr><td><code>@property.Name</code></td><td>@type</td><td>@if (required.Contains(property.Name)) { <span class="tool-required">Yes</span> } else { <span>No</span> }</td><td>@description</td></tr>
                        }
                        </tbody>
                    </table></div>
                }
                else { <p>No individual input parameters are declared in the schema.</p> }
            </section>
        </div>
        <div class="tool-details-stack">
            <section class="tool-panel" id="tool-schema">
                <div class="tool-panel-heading"><div><h2><span class="tool-panel-symbol" aria-hidden="true">&lt;/&gt;</span> JSON Schema</h2><p>The registered input contract for this tool.</p></div><button class="tool-copy" type="button" data-copy-target="tool-schema-code">Copy</button></div>
                <pre class="tool-code"><code id="tool-schema-code">@formattedSchema</code></pre>
            </section>
            <section class="tool-panel" id="tool-example">
                <div class="tool-panel-heading"><div><h2><span class="tool-panel-symbol" aria-hidden="true">▶</span> Example Input</h2><p>Illustrative values based on the schema; not executed.</p></div><button class="tool-copy" type="button" data-copy-target="tool-example-code">Copy</button></div>
                <pre class="tool-code"><code id="tool-example-code">@exampleJson</code></pre>
            </section>
            <p class="tool-execution-note">Tool execution is not available from this page. No authorization or runtime controls are exposed.</p>
        </div>
    </div>
</div>
<script>
document.querySelectorAll('.tool-details-page [data-copy-target]').forEach(button => {
    button.addEventListener('click', async () => {
        const code = document.getElementById(button.dataset.copyTarget);
        if (!code || !navigator.clipboard) return;
        try {
            await navigator.clipboard.writeText(code.textContent || '');
            button.textContent = 'Copied';
            button.setAttribute('aria-label', 'Copied to clipboard');
        } catch {
            button.textContent = 'Copy failed';
        }
    });
});
</script>
