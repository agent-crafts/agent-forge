@model AgentForge.Web.Controllers.ToolsController.ToolCatalogItem
@using System.Text.Json
@{
    Layout = "_AppLayout";
    using var schemaDocument = JsonDocument.Parse(Model.JsonSchema);
    var schema = schemaDocument.RootElement;
    var hasProperties = schema.TryGetProperty("properties", out var properties) && properties.ValueKind == JsonValueKind.Object;
    var required = new HashSet<string>(StringComparer.Ordinal);
    if (schema.TryGetProperty("required", out var requiredElement) && requiredElement.ValueKind == JsonValueKind.Array)
    {
        foreach (var item in requiredElement.EnumerateArray())
        {
            if (item.ValueKind == JsonValueKind.String && item.GetString() is { } name) required.Add(name);
        }
    }
    var isGitHub = Model.Icon == "github";
    var source = Model.Category == "github" ? "GitHub" : "Registered tool";
    var example = new Dictionary<string, object?>();
    if (hasProperties)
    {
        foreach (var property in properties.EnumerateObject())
        {
            var value = property.Value;
            var type = value.TryGetProperty("type", out var typeElement) ? typeElement.GetString() : "string";
            example[property.Name] = type switch
            {
                "integer" => value.TryGetProperty("minimum", out var minimum) && minimum.TryGetInt32(out var min) ? Math.Max(1, min) : 1,
                "number" => 1,
                "boolean" => true,
                "array" => Array.Empty<string>(),
                "object" => new Dictionary<string, object>(),
                _ => property.Name.Equals("owner", StringComparison.OrdinalIgnoreCase) ? "octocat"
                    : property.Name.Equals("repo", StringComparison.OrdinalIgnoreCase) ? "hello-world" : "example"
            };
        }
    }
    var exampleJson = JsonSerializer.Serialize(example, new JsonSerializerOptions { WriteIndented = true });
    var formattedSchema = JsonSerializer.Serialize(schema, new JsonSerializerOptions { WriteIndented = true });
}
<div class="ui-detail">
    <section class="ui-profile">
        <div class="ui-profile-icon" aria-hidden="true">
            <partial name="_ToolIcon" model="Model.Icon" />
        </div>
        <div class="ui-profile-main">
            <div class="ui-profile-title"><h1>@Model.DisplayName</h1><span class="ui-badge ui-badge-success">Registered</span></div>
            <p>@Model.Description</p>
            <div class="ui-tags"><span>@Model.Name</span><span>@source</span><span>API Tool</span><span>Read-only catalog</span></div>
        </div>
        <div class="ui-metadata">
            <div><small>TYPE</small><strong>API Tool</strong></div>
            <div><small>SOURCE</small><strong>@source</strong></div>
            <div><small>REGISTRY</small><strong>Available</strong></div>
            <div><small>EXECUTION</small><strong>Not enabled</strong></div>
        </div>
    </section>
    <div class="mt-6 flex gap-2 border-b border-line" role="tablist" aria-label="Tool details sections">
        <button type="button" id="toolOverviewTab" role="tab" aria-controls="toolOverviewPanel" aria-selected="true" class="border-b-2 border-accent px-5 py-3 text-sm font-semibold text-heading">Overview</button>
        <button type="button" id="toolTryTab" role="tab" aria-controls="toolTryPanel" aria-selected="false" tabindex="-1" class="border-b-2 border-transparent px-5 py-3 text-sm font-semibold text-muted">Try Now</button>
    </div>
    <div id="toolOverviewPanel" role="tabpanel" aria-labelledby="toolOverviewTab">
    <div class="ui-columns">
        <div class="ui-stack">
            <section class="ui-panel" id="tool-overview">
                <h2><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9"/><path d="M8 3h7l6 6h-6V3"/><path d="M8 13h8M8 17h8"/></svg></span> Overview</h2>
                <p class="ui-subtitle">What this tool does and when to use it.</p>
                <p>@Model.Description</p>
                <div class="ui-note"><strong>When to use this tool</strong><p>Use this tool when its registered capability matches your task. Review the input contract before integrating it into an agent workflow.</p></div>
            </section>
            <section class="ui-panel" id="tool-parameters">
                <h2><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 17h16"/><circle cx="9" cy="7" r="2" fill="var(--surface-raised)"/><circle cx="15" cy="17" r="2" fill="var(--surface-raised)"/></svg></span> Parameters</h2>
                <p class="ui-subtitle">Required inputs, types, and descriptions from the registered schema.</p>
                @if (hasProperties)
                {
                    <div class="ui-table-scroll"><table class="ui-table">
                        <thead><tr><th>Parameter</th><th>Type</th><th>Required</th><th>Description</th></tr></thead>
                        <tbody>
                        @foreach (var property in properties.EnumerateObject())
                        {
                            var parameter = property.Value;
                            var type = parameter.TryGetProperty("type", out var parameterType) ? parameterType.ToString() : "any";
                            var description = parameter.TryGetProperty("description", out var parameterDescription) ? parameterDescription.GetString() : "—";
                            <tr><td><code>@property.Name</code></td><td>@type</td><td>@if (required.Contains(property.Name)) { <span class="ui-required">Yes</span> } else { <span>No</span> }</td><td>@description</td></tr>
                        }
                        </tbody>
                    </table></div>
                }
                else { <p>No individual input parameters are declared in the schema.</p> }
            </section>
        </div>
        <div class="ui-stack">
            <section class="ui-panel" id="tool-schema">
                <div class="ui-panel-heading"><div><h2><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4C5 4 5 6 5 8v1c0 2-1 3-3 3 2 0 3 1 3 3v1c0 2 0 4 3 4M16 4c3 0 3 2 3 4v1c0 2 1 3 3 3-2 0-3 1-3 3v1c0 2 0 4-3 4"/></svg></span> JSON Schema</h2><p>The registered input contract for this tool.</p></div><button class="ui-copy" type="button" data-copy-target="tool-schema-code">Copy</button></div>
                <pre class="ui-code"><code id="tool-schema-code" data-json-highlight>@formattedSchema</code></pre>
            </section>
            <section class="ui-panel" id="tool-example">
                <div class="ui-panel-heading"><div><h2><span class="ui-panel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="19" height="16" rx="2"/><path d="m7 9 3 3-3 3M12 15h5"/></svg></span> Example Input</h2><p>Illustrative values based on the schema; not executed.</p></div><button class="ui-copy" type="button" data-copy-target="tool-example-code">Copy</button></div>
                <pre class="ui-code"><code id="tool-example-code" data-json-highlight>@exampleJson</code></pre>
            </section>
            <p class="ui-footnote">Tool execution is not available from this page. No authorization or runtime controls are exposed.</p>
        </div>
    </div>
    </div>
    <section id="toolTryPanel" role="tabpanel" aria-labelledby="toolTryTab" hidden class="mt-6 rounded-2xl border border-line bg-surface p-6">
        <h2 class="text-xl font-semibold text-heading">Try Now</h2>
        <p class="mt-2 text-sm text-muted">Run this tool with validated input once secure execution is enabled.</p>
        <div class="mt-5 rounded-xl border border-line bg-raised p-4">
            <h3 class="text-sm font-semibold text-heading">Execution not available</h3>
            <p class="mt-2 text-sm text-muted">AgentForge currently provides a read-only tool registry. Authentication, authorization, and a controlled executor are required before testing tools.</p>
        </div>
        <button type="button" disabled class="mt-5 cursor-not-allowed rounded-xl border border-line bg-raised px-5 py-3 text-sm font-semibold text-muted opacity-70">Run Tool</button>
    </section>
</div>

<script>
document.querySelectorAll('code[data-json-highlight]').forEach(code => {
    const json = code.textContent || '';
    const output = document.createDocumentFragment();
    const tokens = json.split(/("(?:[^"\\]|\\.)*")/g);
    tokens.forEach((part, index) => {
        if (!part) return;
        if (index % 2 === 1) {
            const span = document.createElement('span');
            span.className = /^\s*:/.test(tokens[index + 1] || '') ? 'ui-json-key' : 'ui-json-string';
            span.textContent = part;
            output.append(span);
        } else {
            part.split(/(\btrue\b|\bfalse\b|\bnull\b|-?\d+(?:\.\d+)?)/g).forEach(value => {
                if (!value) return;
                if (/^(true|false|null|-?\d+(?:\.\d+)?)$/.test(value)) {
                    const span = document.createElement('span');
                    span.className = /^(true|false|null)$/.test(value) ? 'ui-json-literal' : 'ui-json-number';
                    span.textContent = value;
                    output.append(span);
                } else output.append(document.createTextNode(value));
            });
        }
    });
    code.replaceChildren(output);
});
document.querySelectorAll('.ui-detail [data-copy-target]').forEach(button => {
    button.addEventListener('click', async () => {
        const code = document.getElementById(button.dataset.copyTarget);
        if (!code || !navigator.clipboard) return;
        try {
            await navigator.clipboard.writeText(code.textContent || '');
            button.textContent = 'Copied';
            button.setAttribute('aria-label', 'Copied to clipboard');
        } catch {
            button.textContent = 'Copy failed';
        }
    });
});
</script>

<script>
(() => {
    const tabs = [document.getElementById('toolOverviewTab'), document.getElementById('toolTryTab')];
    const panels = [document.getElementById('toolOverviewPanel'), document.getElementById('toolTryPanel')];
    tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
            tabs.forEach((item, i) => {
                const active = i === index;
                item.setAttribute('aria-selected', String(active));
                item.tabIndex = active ? 0 : -1;
                item.classList.toggle('border-accent', active);
                item.classList.toggle('border-transparent', !active);
                item.classList.toggle('text-heading', active);
                item.classList.toggle('text-muted', !active);
                panels[i].hidden = !active;
            });
        });
        tab.addEventListener('keydown', event => {
            if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
            event.preventDefault();
            const next = (index + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length;
            tabs[next].focus();
            tabs[next].click();
        });
    });
})();
</script>
