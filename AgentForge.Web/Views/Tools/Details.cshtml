@model AgentForge.Web.Controllers.ToolsController.ToolCatalogItem
@{
    Layout = "_AppLayout";
}
<nav aria-label="Breadcrumb" class="mb-5 flex items-center gap-2 break-words text-xs text-muted">
    <a asp-controller="Tools" asp-action="Index" class="text-accent no-underline hover:underline">Tools Gallery</a>
    <span aria-hidden="true">/</span><span aria-current="page">@Model.Name</span>
</nav>
<article class="max-w-4xl rounded-2xl border border-line bg-surface p-6 sm:p-8">
    <div class="mb-5 flex items-center justify-between gap-3">
        <span aria-hidden="true" class="grid size-14 place-items-center rounded-xl bg-raised text-2xl text-accent">⚒</span>
        <span class="inline-flex items-center gap-2 rounded-full bg-raised px-3 py-2 text-xs font-semibold text-muted">
            <span class="size-2 rounded-full bg-emerald-500"></span> Registered
        </span>
    </div>
    <h1 class="m-0 break-words text-2xl font-bold text-heading">@Model.Name</h1>
    <p class="mt-3 text-sm leading-relaxed text-muted">@Model.Description</p>
    <hr class="my-6 border-0 border-t border-line" />
    <h2 class="mb-2 text-base font-semibold text-heading">Overview</h2>
    <p class="text-sm leading-relaxed text-muted">This tool is available in the AgentForge gallery. Project selection is not enabled yet.</p>
    <hr class="my-6 border-0 border-t border-line" />
    <h2 class="mb-2 text-base font-semibold text-heading">Input schema</h2>
    <p class="mb-4 text-sm text-muted">Arguments accepted by this tool. Execution is not available from this page.</p>
    <pre class="overflow-x-auto whitespace-pre-wrap break-words rounded-xl border border-line bg-app p-5 text-xs leading-relaxed text-content"><code>@Model.JsonSchema</code></pre>
</article>
