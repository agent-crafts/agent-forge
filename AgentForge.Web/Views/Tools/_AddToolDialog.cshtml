@using AgentForge.Core.Enums
@using System.ComponentModel
@{
    Func<Enum, string> enumLabel = value =>
        value.GetType().GetField(value.ToString())?
            .GetCustomAttributes(typeof(DescriptionAttribute), false)
            .OfType<DescriptionAttribute>()
            .FirstOrDefault()?.Description ?? value.ToString();
    Func<dynamic, Microsoft.AspNetCore.Html.IHtmlContent> body = @<text>
            <fieldset class="mb-5 grid grid-cols-1 gap-2 border-0 p-0 sm:grid-cols-2">
                <legend class="sr-only">Tool type</legend>
                <label class="group flex cursor-pointer items-center gap-2.5 rounded-xl border-0 bg-raised px-3.5 py-3 text-left transition-colors duration-150 hover:bg-hover has-[:checked]:bg-[var(--active)] has-[:checked]:ring-1 has-[:checked]:ring-inset has-[:checked]:ring-accent has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-accent"><input class="sr-only" type="radio" name="toolKind" value="@ToolKind.Custom.ToString().ToLowerInvariant()" checked /><svg class="size-[26px] shrink-0 text-muted group-has-[:checked]:text-accent" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a5 5 0 0 0-6.4 6.4l-5.1 5.1a2 2 0 0 0 2.8 2.8l5.1-5.1a5 5 0 0 0 6.4-6.4L14 12l-2-2 2.7-3.7Z"/></svg><span><strong class="block text-[13px] leading-snug text-heading">@enumLabel(ToolKind.Custom)</strong><small class="mt-0.5 block text-[11px] leading-snug text-muted">Define a tool built for AgentForge.</small></span></label>
                <label class="group flex cursor-pointer items-center gap-2.5 rounded-xl border-0 bg-raised px-3.5 py-3 text-left transition-colors duration-150 hover:bg-hover has-[:checked]:bg-[var(--active)] has-[:checked]:ring-1 has-[:checked]:ring-inset has-[:checked]:ring-accent has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-accent"><input class="sr-only" type="radio" name="toolKind" value="@ToolKind.External.ToString().ToLowerInvariant()" /><svg class="size-[26px] shrink-0 text-muted group-has-[:checked]:text-accent" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22v-6M9 8V2m6 6V2M7 8h10v3a5 5 0 0 1-10 0V8Z"/></svg><span><strong class="block text-[13px] leading-snug text-heading">@enumLabel(ToolKind.External)</strong><small class="mt-0.5 block text-[11px] leading-snug text-muted">Discover tools from a trusted external provider.</small></span></label>
            </fieldset>
            <section data-tool-panel="custom" class="grid gap-2.5 [&_.ui-input]:w-full [&_.ui-select]:w-full [&_.ui-input]:min-w-0 [&_.ui-select]:min-w-0" aria-label="Custom tool configuration">
                
                <label class="mt-2 block text-[13px] font-semibold text-heading" for="newToolName">Tool Name</label>
                <input class="ui-input" id="newToolName" name="name" placeholder="read_project_status" pattern="[a-z][a-z0-9_]*" maxlength="100" />
                <label class="mt-2 block text-[13px] font-semibold text-heading" for="newToolDescription">Description</label>
                <textarea class="ui-input min-h-24" id="newToolDescription" name="description" placeholder="What does this tool do?"></textarea>
                <label class="mt-2 block text-[13px] font-semibold text-heading" for="newToolDisplayName">Display Name</label>
                <input class="ui-input" id="newToolDisplayName" name="displayName" placeholder="Read Project Status" maxlength="120" />
                <label class="mt-2 block text-[13px] font-semibold text-heading" for="newToolCategory">Category</label>
                <select class="ui-select" id="newToolCategory" name="category" aria-describedby="toolCategoryHelp">
                    @foreach (var category in Enum.GetValues<ToolCategory>())
                    {
                        <option value="@category.ToString().ToLowerInvariant()">@enumLabel(category)</option>
                    }
                </select>
                <p id="toolCategoryHelp" class="text-[13px] text-muted">Select the category that best describes this tool.</p>
                <label class="mt-2 block text-[13px] font-semibold text-heading" for="newToolImage">Image URL</label>
                <input class="ui-input" id="newToolImage" name="imageUrl" type="url" placeholder="https://example.com/tool-icon.png" aria-describedby="toolImageHelp" />
                <p id="toolImageHelp" class="text-[13px] text-muted">Optional HTTPS image URL for the tool icon. Image upload is not implemented yet.</p>
                <h3 class="mt-2 text-base font-semibold text-heading">Parameters</h3>
                <p class="text-[13px] leading-6 text-muted">Define input parameters. The JSON Schema preview is generated automatically.</p>
                <div id="toolParameterRows" class="grid gap-4 [&_.ui-modal-parameter]:flex [&_.ui-modal-parameter]:flex-wrap [&_.ui-modal-parameter]:items-center [&_.ui-modal-parameter]:gap-3 [&_.param-name]:min-w-0 [&_.param-name]:flex-[2_1_180px] [&_.param-type]:min-w-0 [&_.param-type]:flex-[1_1_130px] [&_.param-type]:w-auto [&_.param-required]:mr-1 [&_.param-remove]:inline-flex [&_.param-remove]:size-9 [&_.param-remove]:flex-none [&_.param-remove]:items-center [&_.param-remove]:justify-center [&_.param-remove]:rounded-lg [&_.param-remove]:border-0 [&_.param-remove]:bg-transparent [&_.param-remove]:p-0 [&_.param-remove]:text-red-600 [&_.param-remove]:hover:bg-red-100 [&_.param-remove]:hover:text-red-700 [&_.param-remove]:focus-visible:outline-2 [&_.param-remove]:focus-visible:outline-offset-2 [&_.param-remove]:focus-visible:outline-accent"></div>
                <button type="button" id="addToolParameter" class="ui-button">+ Add parameter</button>
                <label class="mt-2 block text-[13px] font-semibold text-heading" for="newToolSchema">Generated JSON Schema</label>
                <div class="ui-modal-schema-preview max-h-52 overflow-auto"><partial name="_JsonViewer" model='("newToolSchema", (string?)null)' /></div>
                <p class="text-[13px] leading-6 text-muted">An approved implementation and execution policy are required before this tool can run.</p>
            </section>
            <section data-tool-panel="external" class="grid gap-2.5 [&_.ui-input]:w-full [&_.ui-select]:w-full [&_.ui-input]:min-w-0 [&_.ui-select]:min-w-0" aria-label="External tool configuration" hidden>
                
                <label class="mt-2 block text-[13px] font-semibold text-heading" for="externalToolSource">Source type</label>
                <select class="ui-select" id="externalToolSource">
                    @foreach (var sourceType in Enum.GetValues<ExternalToolSourceType>())
                    {
                        <option value="@sourceType.ToString().ToLowerInvariant()">@enumLabel(sourceType)</option>
                    }
                </select>
                <div id="externalEndpointField">
                    <label class="mt-2 block text-[13px] font-semibold text-heading" for="externalToolEndpoint">Specification URL / server endpoint</label>
                    <input class="ui-input" id="externalToolEndpoint" type="url" placeholder="https://example.com/openapi.json" />
                </div>
                <div id="externalIntegrationField" hidden>
                    <label class="mt-2 block text-[13px] font-semibold text-heading" for="externalToolIntegration">Integration</label>
                    <select class="ui-select" id="externalToolIntegration"><option value="">Choose an integration</option><option value="github">GitHub</option><option value="jira">Jira</option></select>
                </div>
                <p class="text-[13px] leading-6 text-muted">Discovery requires a trusted connection, validation, and explicit review of imported tools. No external endpoint is contacted by this form.</p>
            </section>
            <p id="addToolFeedback" class="mt-4 min-h-5 text-[13px] text-accent" role="status" aria-live="polite"></p>
</text>;
    var dialog = (Id: "addToolDialog", TitleId: "addToolTitle", DescriptionId: "addToolIntro", Title: "Add Tool", Description: "Configure a custom tool or connect an external source.", Body: body, PrimaryButtonText: "Save", PrimaryButtonId: "previewToolConfiguration", CancelButtonText: "Cancel");
}
<partial name="_Dialog" model="dialog" />
