@model IReadOnlyList<AgentForge.Web.Controllers.ToolsController.ToolCatalogItem>
@{
    Layout = "_AppLayout";
}
<header class="mb-7 flex flex-wrap items-center justify-between gap-4">
    <div>
        <h1 class="m-0 text-2xl font-bold tracking-tight text-heading">Tools</h1>
        <p class="mt-1.5 mb-0 text-sm leading-6 text-muted">Explore and manage tools available for your projects.</p>
    </div>
    <button type="button" disabled title="Adding tools is coming soon"
            class="inline-flex cursor-not-allowed items-center gap-2 rounded-xl border border-line-strong bg-raised px-4 py-2.5 text-sm font-semibold text-muted opacity-70">
        <span aria-hidden="true" class="text-xl">+</span> Add Tool
        <span class="text-xs font-normal">(Coming soon)</span>
    </button>
</header>
<div class="mb-6 flex flex-col gap-3 sm:flex-row">
    <label class="sr-only" for="toolSearch">Search tools</label>
    <input id="toolSearch" type="search" placeholder="Search tools..." autocomplete="off"
           class="min-w-0 flex-1 rounded-xl border border-line bg-surface px-4 py-3 text-sm text-content placeholder:text-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" />
    <label class="sr-only" for="toolCategory">Filter by integration</label>
    <select id="toolCategory" aria-label="Filter tools by integration"
            class="w-full cursor-pointer rounded-xl border border-line bg-surface px-4 py-3 text-sm text-content focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:w-48">
        <option value="all">All Categories</option>
        <option value="github">GitHub</option>
        <option value="jira">Jira</option>
    </select>
</div>
<div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
    @foreach (var tool in Model)
    {
        <a data-search="@($"{tool.Name} {tool.Description}".ToLowerInvariant())"
           data-category="@(tool.Name.Contains("github", StringComparison.OrdinalIgnoreCase) ? "github" : tool.Name.Contains("jira", StringComparison.OrdinalIgnoreCase) ? "jira" : "other")"
           asp-controller="Tools" asp-action="Details" asp-route-name="@tool.Name"
           aria-label="View details for @tool.Name"
           class="group flex min-w-0 items-center gap-4 rounded-xl border border-line bg-surface px-4 py-4 text-content no-underline transition-all duration-150 hover:-translate-y-0.5 hover:border-line-strong hover:bg-hover hover:shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
            <span aria-hidden="true" class="grid size-12 shrink-0 place-items-center rounded-lg bg-raised text-xl text-accent">⚒</span>
            <span class="flex min-w-0 flex-1 flex-col gap-1">
                <span class="break-words text-sm font-semibold text-heading">@tool.Name</span>
                <span class="break-words text-xs leading-5 text-muted">@tool.Description</span>
            </span>
            <span aria-hidden="true" class="shrink-0 text-lg text-muted transition-transform group-hover:translate-x-1">→</span>
        </a>
    }
</div>
@if (Model.Count == 0)
{
    <p class="mt-4 rounded-xl border border-dashed border-line p-6 text-sm text-muted">No tools registered yet.</p>
}
<p id="toolSearchEmpty" class="mt-4 rounded-xl border border-dashed border-line p-6 text-sm text-muted" hidden>No tools match your search.</p>
<script src="~/js/tools-gallery.js" asp-append-version="true"></script>
