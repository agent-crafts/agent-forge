@using AgentForge.Core.Enums
@using System.ComponentModel
@model IReadOnlyList<AgentForge.Web.Controllers.ToolsController.ToolCatalogItem>
@{
    Layout = "_AppLayout";
    Func<Enum, string> enumLabel = value => value.GetType().GetField(value.ToString())?.GetCustomAttributes(typeof(DescriptionAttribute), false).OfType<DescriptionAttribute>().FirstOrDefault()?.Description ?? value.ToString();
}
<div class="ui-toolbar mb-6 flex flex-wrap items-center gap-3">
    <label class="ui-visually-hidden" for="toolSearch">Search tools</label>
    <input id="toolSearch" type="search" placeholder="Search tools..." autocomplete="off"
           class="ui-input box-border h-11 min-w-0 flex-1 rounded-xl border border-line bg-surface px-4 py-0 text-sm text-content placeholder:text-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" />
    <label class="ui-visually-hidden" for="toolCategory">Filter by category</label>
    <div class="ui-select-wrap relative h-11 shrink-0">
        <select id="toolCategory" aria-label="Filter tools by category"
                class="ui-select box-border h-11 w-full appearance-none cursor-pointer rounded-xl border border-line bg-surface py-0 pl-4 pr-10 text-sm text-content focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
            <option value="all">All Categories</option>
            @foreach (var toolCategory in Enum.GetValues<ToolCategory>())
            {
                <option value="@toolCategory.ToString().ToLowerInvariant()">@enumLabel(toolCategory)</option>
            }
        </select>
        <svg class="ui-select-chevron pointer-events-none absolute right-3 size-4 text-muted" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
    </div>
    <button type="button" id="openAddToolDialog" aria-haspopup="dialog" aria-controls="addToolDialog"
            class="ui-button box-border inline-flex h-11 shrink-0 items-center justify-center gap-2 rounded-xl border border-line-strong bg-raised px-4 py-0 text-sm font-semibold leading-none text-content">
        <span aria-hidden="true" class="text-lg leading-none">+</span> Add Tool
    </button>
</div>
<div class="ui-grid grid grid-cols-1 gap-3 lg:grid-cols-2">
    @foreach (var tool in Model)
    {
        <a data-search="@($"{tool.DisplayName} {tool.Name} {tool.Description}".ToLowerInvariant())"
           data-category="@tool.Category.ToString().ToLowerInvariant()"
           href="/tools/@Uri.EscapeDataString(tool.Name)"
           aria-label="View details for @tool.DisplayName"
           class="ui-item-card group flex min-w-0 items-start cursor-default gap-3 rounded-xl border border-line bg-surface px-3 py-3 text-content no-underline transition-all duration-150 hover:-translate-y-0.5 hover:border-line-strong hover:bg-hover hover:shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
            <span aria-hidden="true" class="ui-icon-tile self-start">
                <partial name="_ToolIcon" model="tool.Icon" />
            </span>
            <span class="ui-item-content flex min-w-0 flex-1 flex-col gap-0.5">
                <span class="ui-item-title break-words text-sm font-semibold text-heading">@tool.DisplayName</span>
                <span class="ui-item-description break-words text-xs leading-5 text-muted">@tool.Description</span>
                <span class="ui-tool-card-badges" aria-label="Tool kind and category">
                    <span class="ui-tool-card-badge"><span class="ui-tool-card-badge-label">Kind</span> @tool.Kind</span>
                    <span class="ui-tool-card-badge"><span class="ui-tool-card-badge-label">Category</span> @tool.Category</span>
                </span>
            </span>
        </a>
    }
</div>
@if (Model.Count == 0)
{
    <p class="mt-4 rounded-xl border border-dashed border-line p-6 text-sm text-muted">No tools registered yet.</p>
}
<p id="toolSearchEmpty" class="mt-4 rounded-xl border border-dashed border-line p-6 text-sm text-muted" hidden>No tools match your search.</p>
<partial name="~/Views/Tools/_AddToolDialog.cshtml" />
<script src="~/js/tools/tools-gallery.js" asp-append-version="true"></script>

<script src="~/js/tools/add-tool-dialog.js" asp-append-version="true"></script>
