@model IReadOnlyList<AgentForge.Web.Controllers.ToolsController.ToolCatalogItem>
@{
    Layout = "_AppLayout";
}
<link rel="stylesheet" href="~/css/tools.css" asp-append-version="true" />
<div class="tools-gallery-intro"><h2>Explore tools</h2><p>Discover capabilities for your projects.</p></div>
<label class="sr-only" for="toolSearch">Search tools</label>
<input id="toolSearch" class="tools-search" type="search" placeholder="Search tools..." autocomplete="off" />
<div class="tools-count">@Model.Count registered @(Model.Count == 1 ? "tool" : "tools")</div>
<div class="tools-grid">
    @foreach (var tool in Model)
    {
        <article class="tool-card" data-search="@($"{tool.Name} {tool.Description}".ToLowerInvariant())">
            <div class="tool-card-top">
                <span class="tool-icon" aria-hidden="true">⚒</span>
                <span class="tool-status"><span class="tool-status-dot"></span>Registered</span>
            </div>
            <h2>@tool.Name</h2>
            <p>@tool.Description</p>
            <a class="tool-link" asp-controller="Tools" asp-action="Details" asp-route-name="@tool.Name">
                View details <span aria-hidden="true">→</span>
            </a>
        </article>
    }
    @if (Model.Count == 0)
    {
        <div class="tool-empty">No tools registered yet.</div>
    }
</div>
