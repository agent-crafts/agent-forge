@model IReadOnlyList<AgentForge.Web.Controllers.ToolsController.ToolCatalogItem>
@{
    Layout = "_AppLayout";
}
<link rel="stylesheet" href="~/css/tools.css" asp-append-version="true" />
<div class="tools-search-row mb-6 flex flex-col gap-3 sm:flex-row">
    <label class="sr-only" for="toolSearch">Search tools</label>
    <input id="toolSearch" type="search" placeholder="Search tools..." autocomplete="off"
           class="tools-search min-w-0 flex-1 rounded-xl border border-line bg-surface py-3 pl-4 pr-10 text-sm text-content placeholder:text-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" />
    <label class="sr-only" for="toolCategory">Filter by integration</label>
    <select id="toolCategory" aria-label="Filter tools by integration"
            class="tools-category w-full appearance-none cursor-pointer rounded-xl border border-line bg-surface px-4 py-3 text-sm text-content focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:w-48">
        <option value="all">All Categories</option>
        <option value="github">GitHub</option>
        <option value="jira">Jira</option>
    </select>
    <svg class="tools-category-chevron pointer-events-none absolute right-3 top-1/2 size-4 -translate-y-1/2 text-muted" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
    </div>
    <button type="button" disabled title="Adding tools is coming soon"
            class="tools-add-button inline-flex shrink-0 cursor-not-allowed items-center justify-center gap-2 rounded-xl border border-line-strong bg-raised px-4 py-3 text-sm font-semibold text-muted opacity-70">
        <span aria-hidden="true" class="text-xl">+</span> Add Tool
        <span class="text-xs font-normal">(Coming soon)</span>
    </button>
</div>
<div class="tools-grid grid grid-cols-1 gap-3 lg:grid-cols-2">
    @foreach (var tool in Model)
    {
        <a data-search="@($"{tool.Name} {tool.Description}".ToLowerInvariant())"
           data-category="@(tool.Name.Contains("github", StringComparison.OrdinalIgnoreCase) ? "github" : tool.Name.Contains("jira", StringComparison.OrdinalIgnoreCase) ? "jira" : "other")"
           asp-controller="Tools" asp-action="Details" asp-route-name="@tool.Name"
           aria-label="View details for @tool.Name"
           class="tool-card group flex min-w-0 items-center gap-4 rounded-xl border border-line bg-surface px-4 py-4 text-content no-underline transition-all duration-150 hover:-translate-y-0.5 hover:border-line-strong hover:bg-hover hover:shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
            <span aria-hidden="true" class="tool-icon grid size-12 shrink-0 place-items-center rounded-lg bg-raised text-xl text-accent">⚒</span>
            <span class="tool-card-copy flex min-w-0 flex-1 flex-col gap-1">
                <span class="tool-card-name break-words text-sm font-semibold text-heading">@tool.Name</span>
                <span class="tool-card-description break-words text-xs leading-5 text-muted">@tool.Description</span>
            </span>
            <span aria-hidden="true" class="tool-card-arrow shrink-0 text-lg text-muted transition-transform group-hover:translate-x-1">→</span>
        </a>
    }
</div>
@if (Model.Count == 0)
{
    <p class="mt-4 rounded-xl border border-dashed border-line p-6 text-sm text-muted">No tools registered yet.</p>
}
<p id="toolSearchEmpty" class="mt-4 rounded-xl border border-dashed border-line p-6 text-sm text-muted" hidden>No tools match your search.</p>
<script src="~/js/tools-gallery.js" asp-append-version="true"></script>
