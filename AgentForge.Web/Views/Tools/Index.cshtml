@model IReadOnlyList<AgentForge.Web.Controllers.ToolsController.ToolCatalogItem>
@{
    Layout = "_AppLayout";
}
<link rel="stylesheet" href="~/css/tools.css" asp-append-version="true" />
<header class="tools-page-header">
    <div class="tools-page-heading">
        <h1>Tools</h1>
        <p>Explore and manage tools available for your projects.</p>
    </div>
    <button class="tools-add-button" type="button" disabled title="Adding tools is coming soon">
        <span aria-hidden="true">+</span> Add Tool
        <span class="tools-coming-soon">(Coming soon)</span>
    </button>
</header>
<div class="tools-search-row">
    <label class="sr-only" for="toolSearch">Search tools</label>
    <input id="toolSearch" class="tools-search" type="search" placeholder="Search tools..." autocomplete="off" />
    <label class="sr-only" for="toolCategory">Filter by integration</label>
    <select id="toolCategory" class="tools-category" aria-label="Filter tools by integration">
        <option value="all">All Categories</option>
        <option value="github">GitHub</option>
        <option value="jira">Jira</option>
    </select>
</div>
<div class="tools-grid">
    @foreach (var tool in Model)
    {
        <a class="tool-card" data-search="@($"{tool.Name} {tool.Description}".ToLowerInvariant())"
           data-category="@(tool.Name.Contains("github", StringComparison.OrdinalIgnoreCase) ? "github" : tool.Name.Contains("jira", StringComparison.OrdinalIgnoreCase) ? "jira" : "other")"
           asp-controller="Tools" asp-action="Details" asp-route-name="@tool.Name"
           aria-label="View details for @tool.Name">
            <span class="tool-icon" aria-hidden="true">⚒</span>
            <span class="tool-card-copy">
                <span class="tool-card-name">@tool.Name</span>
                <span class="tool-card-description">@tool.Description</span>
            </span>
            <span class="tool-card-arrow" aria-hidden="true">→</span>
        </a>
    }
</div>
@if (Model.Count == 0)
{
    <p class="tool-empty">No tools registered yet.</p>
}
<p id="toolSearchEmpty" class="tool-empty" hidden>No tools match your search.</p>
<script src="~/js/tools-gallery.js" asp-append-version="true"></script>
