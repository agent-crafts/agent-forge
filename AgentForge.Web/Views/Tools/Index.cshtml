@model IReadOnlyList<AgentForge.Web.Controllers.ToolsController.ToolCatalogItem>
@{
    Layout = "_AppLayout";
}
<div class="ui-toolbar mb-6 flex flex-nowrap items-center gap-3">
    <label class="sr-only" for="toolSearch">Search tools</label>
    <input id="toolSearch" type="search" placeholder="Search tools..." autocomplete="off"
           class="ui-input min-w-0 flex-1 rounded-xl border border-line bg-surface px-4 py-3 text-sm text-content placeholder:text-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" />
    <label class="sr-only" for="toolCategory">Filter by integration</label>
    <div class="ui-select-wrap relative shrink-0">
        <select id="toolCategory" aria-label="Filter tools by integration"
                class="ui-select w-full appearance-none cursor-pointer rounded-xl border border-line bg-surface py-3 pl-4 pr-10 text-sm text-content focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
            <option value="all">All Categories</option>
            <option value="github">GitHub</option>
            <option value="jira">Jira</option>
        </select>
        <svg class="ui-select-chevron pointer-events-none absolute right-3 top-1/2 size-4 -translate-y-1/2 text-muted" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
    </div>
    <button type="button" disabled title="Adding tools is coming soon"
            class="ui-button inline-flex shrink-0 cursor-not-allowed items-center justify-center gap-2 rounded-xl border border-line-strong bg-raised px-4 py-3 text-sm font-semibold text-muted opacity-70">
        <span aria-hidden="true" class="text-xl">+</span> Add Tool
        <span class="ui-button-hint text-xs font-normal">(Coming soon)</span>
    </button>
</div>
<div class="ui-grid grid grid-cols-1 gap-3 lg:grid-cols-2">
    @foreach (var tool in Model)
    {
        <a data-search="@($"{tool.DisplayName} {tool.Name} {tool.Description}".ToLowerInvariant())"
           data-category="@tool.Category"
           asp-controller="Tools" asp-action="Details" asp-route-name="@tool.Name"
           aria-label="View details for @tool.DisplayName"
           class="ui-item-card group flex min-w-0 items-center gap-4 rounded-xl border border-line bg-surface px-4 py-4 text-content no-underline transition-all duration-150 hover:-translate-y-0.5 hover:border-line-strong hover:bg-hover hover:shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
            <span aria-hidden="true" class="ui-icon-tile grid size-12 shrink-0 place-items-center rounded-lg bg-raised text-xl text-accent">
                @if (tool.Icon == "github")
                {
                    <svg viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.54v-2.1c-3.1.67-3.75-1.32-3.75-1.32-.5-1.28-1.24-1.24-1.62-1.01-.7.08-.69.08-.69 1.12.08 1.71 1.15 1.71 1.15 1 .1.77 1.5 3.2 1.05.1-.73.39-1.22.71-1.5-2.48-.28-5.09-1.24-5.09-5.49 0-1.21.43-2.2 1.14-2.97-.12-.28-.5-1.41.11-2.94 0 0 .93-.3 3.05 1.13a10.6 10.6 0 0 1 5.55 0c2.12-1.43 3.05-1.13 3.05-1.13.61 1.53.23 2.66.11 2.94.71.77 1.14 1.76 1.14 2.97 0 4.26-2.62 5.2-5.11 5.48.4.35.76 1.02.76 2.06v3.05c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" focusable="false"><path d="M12 3v4m0 10v4M3 12h4m10 0h4M5.6 5.6l2.8 2.8m7.2 7.2 2.8 2.8m0-12.8-2.8 2.8m-7.2 7.2-2.8 2.8"/><circle cx="12" cy="12" r="4"/></svg>
                }
            </span>
            <span class="ui-item-content flex min-w-0 flex-1 flex-col gap-1">
                <span class="ui-item-title break-words text-sm font-semibold text-heading">@tool.DisplayName</span>
                <span class="ui-item-description break-words text-xs leading-5 text-muted">@tool.Description</span>
            </span>
            <span aria-hidden="true" class="ui-item-arrow shrink-0 text-lg text-muted transition-transform group-hover:translate-x-1">→</span>
        </a>
    }
</div>
@if (Model.Count == 0)
{
    <p class="mt-4 rounded-xl border border-dashed border-line p-6 text-sm text-muted">No tools registered yet.</p>
}
<p id="toolSearchEmpty" class="mt-4 rounded-xl border border-dashed border-line p-6 text-sm text-muted" hidden>No tools match your search.</p>
<script src="~/js/tools-gallery.js" asp-append-version="true"></script>
