@{
    ViewData["Title"] = "AgentForge Assistant";
    ViewData["Description"] = "Local inference · Qwen";
    ViewData["Section"] = "chat";
    Layout = "_AppLayout";
}
        <section class="conversation" id="conversation" aria-label="Chat messages" aria-live="polite">
            <div class="welcome" id="welcome">
                <div class="welcome-icon">✦</div>
                <h1>What can we build today?</h1>
                <p>Your local AI engineering companion. Ask a question, explore an idea, or debug some code.</p>
                <div class="suggestions">
                    <button type="button" data-prompt="Explain how an AI agent loop works from first principles.">How does an agent loop work? <span>↗</span></button>
                    <button type="button" data-prompt="Help me design a production-ready .NET AI agent architecture.">Design a .NET agent <span>↗</span></button>
                    <button type="button" data-prompt="What is the difference between context, memory, and RAG?">Context vs memory vs RAG <span>↗</span></button>
                </div>
            </div>
            <div class="messages" id="messages"></div>
        </section>
        <div class="composer-wrap">
            <form id="chatForm" class="composer">
                @Html.AntiForgeryToken()
                <label for="prompt" class="sr-only">Your message</label>
                <textarea id="prompt" rows="1" maxlength="12000" placeholder="Message AgentForge…" required></textarea>
                <div class="composer-actions">
                    <span class="hint">Enter to send · Shift+Enter for new line</span>
                    <button id="sendButton" type="submit" aria-label="Send message" title="Send message">↑</button>
                </div>
            </form>
            <p class="disclaimer">Responses are generated locally. Chat history is kept in this browser tab only; the model receives each message independently.</p>
        </div>

@section Scripts {
    <script src="~/js/agent-chat.js" asp-append-version="true"></script>
}
